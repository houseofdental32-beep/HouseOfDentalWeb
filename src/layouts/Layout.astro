---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackgroundAnimation from '../components/BackgroundAnimation.astro';
import Preloader from '../components/Preloader.astro';
import { getConfig } from '../utils/getConfig';
import { ClientRouter } from 'astro:transitions';
import MobileBottomBar from '../components/MobileBottomBar.astro';
import BookingModal from '../components/BookingModal';
import { generateDentistSchema, generateWebSiteSchema } from '../utils/seoSchemas';

interface Props {
  hideHeader?: boolean;
  hideFooter?: boolean;
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  googleSiteVerification?: string;
  bingSiteVerification?: string;
  schemaMarkup?: string | string[];
}

const config = getConfig();
const currentUrl = new URL(Astro.url.pathname, "https://aurevadental.com").href;

const { 
  hideHeader = false,
  hideFooter = false,
  title = config.site_meta.title,
  description = config.site_meta.description,
  keywords = "dentist in hennur, dental clinic horamavu, root canal treatment bengaluru, clear aligners hennur, dental implants, teeth whitening, best dentist near me, kalyan nagar dentist",
  canonical = currentUrl,
  robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogUrl = canonical,
  ogImage = "https://aurevadental.com/assets/og-image.jpg",
  googleSiteVerification = config.site_meta?.google_site_verification || "",
  bingSiteVerification = config.site_meta?.bing_site_verification || "",
  schemaMarkup
} = Astro.props;

const googleAdsId = config.site_meta?.google_ads_id || "AW-18385058775";
const googleAnalyticsId = config.site_meta?.google_analytics_id || "";
const googleTagManagerId = config.site_meta?.google_tag_manager_id || "GTM-WRVN4QWK";
const primaryTagId = googleAnalyticsId || googleAdsId;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google Tag Manager -->
		{googleTagManagerId && (
			<script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${googleTagManagerId}');`} />
		)}
		<!-- End Google Tag Manager -->

		{/* Google tag (gtag.js) for Google Analytics and Google Ads */}
		{primaryTagId && (
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${primaryTagId}`}></script>
		)}
		<script is:inline define:vars={{ googleAdsId, googleAnalyticsId }}>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  window.gtag = gtag;
		  gtag('js', new Date());

		  if (googleAdsId) {
		    gtag('config', googleAdsId);
		  }
		  if (googleAnalyticsId) {
		    gtag('config', googleAnalyticsId);
		  }

		  // Global Google Ads & GTM Call Conversion Function
		  window.gtag_report_conversion = function(url) {
		    var targetUrl = url || 'tel:09113563040';
		    var navigated = false;
		    var callback = function () {
		      if (!navigated && typeof(url) != 'undefined' && url) {
		        navigated = true;
		        window.location = url;
		      }
		    };

		    // Push to Google Tag Manager dataLayer
		    if (window.dataLayer) {
		      window.dataLayer.push({
		        event: 'clinic_call',
		        event_category: 'Contact',
		        event_action: 'Click to Call',
		        event_label: targetUrl,
		        phone_number: '09113563040',
		        page_location: window.location.href,
		        page_title: document.title
		      });
		    }

		    // Safety timeout in case ad script is blocked or network is slow
		    setTimeout(callback, 500);

		    // Send conversion to Google Ads
		    if (typeof window.gtag === 'function') {
		      window.gtag('event', 'conversion', {
		        'send_to': 'AW-18385058775/c0YWCIGTj-8cENf31r5E',
		        'value': 1.0,
		        'currency': 'INR',
		        'event_callback': callback
		      });
		    } else {
		      callback();
		    }
		    return false;
		  };
		  var gtag_report_conversion = window.gtag_report_conversion;

		  // Global delegated listener for calls, WhatsApp & appointments
		  document.addEventListener('click', function(e) {
		    var callLink = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
		    if (callLink) {
		      var tel = callLink.getAttribute('href') || 'tel:09113563040';
		      if (window.dataLayer) {
		        window.dataLayer.push({
		          event: 'clinic_call',
		          event_category: 'Contact',
		          event_action: 'Phone Call Click',
		          event_label: tel,
		          phone_number: tel.replace('tel:', ''),
		          page_location: window.location.href,
		          page_title: document.title
		        });
		      }
		      if (typeof window.gtag === 'function') {
		        window.gtag('event', 'conversion', {
		          'send_to': 'AW-18385058775/c0YWCIGTj-8cENf31r5E',
		          'value': 1.0,
		          'currency': 'INR'
		        });
		      }
		    }

		    var waLink = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"], a[href*="whatsapp.com"]') : null;
		    if (waLink) {
		      if (window.dataLayer) {
		        window.dataLayer.push({
		          event: 'whatsapp_click',
		          event_category: 'Contact',
		          event_action: 'WhatsApp Chat Click',
		          event_label: waLink.getAttribute('href'),
		          page_location: window.location.href,
		          page_title: document.title
		        });
		      }
		    }

		    var bookBtn = e.target && e.target.closest ? e.target.closest('[data-open-booking]') : null;
		    if (bookBtn) {
		      if (window.dataLayer) {
		        window.dataLayer.push({
          event: 'booking_modal_open',
		          event_category: 'Engagement',
		          event_action: 'Open Booking Modal',
		          page_location: window.location.href,
		          page_title: document.title
		        });
		      }
		    }
		  });

		  // Track pageviews across Astro View Transitions
		  document.addEventListener('astro:page-load', function() {
		    if (window.dataLayer) {
		      window.dataLayer.push({
		        event: 'page_view',
		        page_location: window.location.href,
		        page_path: window.location.pathname,
		        page_title: document.title
		      });
		    }
		    if (typeof window.gtag === 'function') {
		      if (googleAdsId) {
		        window.gtag('event', 'page_view', {
		          page_location: window.location.href,
		          page_path: window.location.pathname,
		          page_title: document.title,
		          send_to: googleAdsId
		        });
		      }
		      if (googleAnalyticsId) {
		        window.gtag('event', 'page_view', {
		          page_location: window.location.href,
		          page_path: window.location.pathname,
		          page_title: document.title,
		          send_to: googleAnalyticsId
		        });
		      }
		    }
		  });
		</script>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#F5F2EB" />
		<meta name="format-detection" content="telephone=yes" />

		<link rel="icon" type="image/png" href="/House_of_Dental_Logo_light.png" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/House_of_Dental_Logo_light.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		{/* Search Console & Webmaster Verification Meta Tags */}
		{googleSiteVerification && (
			<meta name="google-site-verification" content={googleSiteVerification} />
		)}
		{bingSiteVerification && (
			<meta name="msvalidate.01" content={bingSiteVerification} />
		)}

		<!-- Theme toggle prevention of flash (FOUC) -->
		<script is:inline>
			const themeSetup = () => {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			};
			themeSetup();
			document.addEventListener('astro:after-swap', themeSetup);
		</script>

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta name="robots" content={robots} />

		<!-- Local Geo Meta Tags for Google Local Search & Maps -->
		<meta name="geo.region" content="IN-KA" />
		<meta name="geo.placename" content="Bengaluru, Hennur, Horamavu" />
		<meta name="geo.position" content="13.0381741;77.6416031" />
		<meta name="ICBM" content="13.0381741, 77.6416031" />
		<meta name="city" content="Bengaluru" />
		<meta name="state" content="Karnataka" />
		<meta name="country" content="India" />
		<meta name="zipcode" content="562149" />
		
		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		{ogUrl && <meta property="og:url" content={ogUrl} />}
		<meta property="og:site_name" content="House of Dental" />
		<meta property="og:locale" content="en_IN" />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="House of Dental - Luxury Smile Studio in Hennur, Bengaluru" />

		<!-- Open Graph Local Business & Contact Signals -->
		<meta property="business:contact_data:street_address" content={config.site_meta?.address || "1st Floor, BMN complex, New Airport Rd, Gummanahalli, Bagaluru"} />
		<meta property="business:contact_data:locality" content="Bengaluru" />
		<meta property="business:contact_data:region" content="Karnataka" />
		<meta property="business:contact_data:postal_code" content="562149" />
		<meta property="business:contact_data:country_name" content="India" />
		<meta property="business:contact_data:phone_number" content={config.site_meta?.phone || "09113563040"} />
		<meta property="business:contact_data:email" content={config.locations_section?.locations_list?.[0]?.email || "houseofdental32@gmail.com"} />
		<meta property="place:location:latitude" content="13.0381741" />
		<meta property="place:location:longitude" content="77.6416031" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@aurevadental" />
		<meta name="twitter:creator" content="@aurevadental" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		<meta name="twitter:image:alt" content="House of Dental - Hennur, Bengaluru" />

		<!-- Canonical Google Rich Results JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(generateWebSiteSchema())} />
		<script type="application/ld+json" set:html={JSON.stringify(generateDentistSchema(config, Astro.url.pathname === '/' || Astro.url.pathname === ''))} />
		{Array.isArray(schemaMarkup) ? (
			schemaMarkup.map((schema) => (
				<script type="application/ld+json" set:html={schema} />
			))
		) : schemaMarkup ? (
			<script type="application/ld+json" set:html={schemaMarkup} />
		) : null}

		<!-- Preconnect to critical domains for lightning-fast loads -->
		<link rel="preconnect" href="https://maps.googleapis.com" />
		<link rel="preconnect" href="https://maps.gstatic.com" />

		<!-- Asynchronous Google Fonts Loading for zero-render blocking -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link 
			rel="preload" 
			as="style" 
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" 
		/>
		<link 
			rel="stylesheet" 
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" 
			media="print" 
			onload="this.media='all'" 
		/>
		<noscript>
			<link 
				rel="stylesheet" 
				href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" 
			/>
		</noscript>
	</head>
	<body class="bg-japandi-cream text-japandi-charcoal font-sans antialiased selection:bg-japandi-clay selection:text-japandi-charcoal min-h-screen flex flex-col relative z-0 pb-20 md:pb-0">
		<!-- Google Tag Manager (noscript) -->
		{googleTagManagerId && (
			<noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${googleTagManagerId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
		)}
		<!-- End Google Tag Manager (noscript) -->

		<!-- Splash Screen / Preloader -->
		<Preloader />

		<!-- Soothing Background UI Animation -->
		<BackgroundAnimation />

		<!-- Custom Interactive Cursor Component -->
		<CustomCursor client:only="react" />
		
		<!-- Sticky Header Component -->
		{!hideHeader && <Header />}
		
		<!-- Main Content Slot -->
		<main class="flex-grow relative z-10">
			<slot />
		</main>

		<!-- Reusable Footer Component with Canonical NAP -->
		{!hideFooter && <Footer />}

		<!-- Interactive Booking Modal (Accessible site-wide) -->
		<BookingModal client:load />

		<!-- Sticky Mobile Bottom Bar -->
		<MobileBottomBar />
	</body>
</html>

<style is:global define:vars={{
	lightBgPrimary: config.theme_colors.light.bg_primary,
	lightBgSecondary: config.theme_colors.light.bg_secondary,
	lightBorder: config.theme_colors.light.border_color,
	lightText: config.theme_colors.light.text_primary,
	lightMoss: config.theme_colors.light.accent_moss,
	lightEarth: config.theme_colors.light.accent_earth,
	
	darkBgPrimary: config.theme_colors.dark.bg_primary,
	darkBgSecondary: config.theme_colors.dark.bg_secondary,
	darkBorder: config.theme_colors.dark.border_color,
	darkText: config.theme_colors.dark.text_primary,
	darkMoss: config.theme_colors.dark.accent_moss,
	darkEarth: config.theme_colors.dark.accent_earth
}}>
	:root {
		--color-bg-primary: var(--lightBgPrimary);
		--color-bg-secondary: var(--lightBgSecondary);
		--color-border: var(--lightBorder);
		--color-text-primary: var(--lightText);
		--color-accent-moss: var(--lightMoss);
		--color-accent-earth: var(--lightEarth);
	}

	html.dark {
		--color-bg-primary: var(--darkBgPrimary);
		--color-bg-secondary: var(--darkBgSecondary);
		--color-border: var(--darkBorder);
		--color-text-primary: var(--darkText);
		--color-accent-moss: var(--darkMoss);
		--color-accent-earth: var(--darkEarth);
	}
</style>
