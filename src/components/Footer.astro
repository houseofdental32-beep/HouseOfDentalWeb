---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { social_media, site_meta, locations_section } = config;
const primaryLocation = locations_section?.locations_list?.[0] || {};
const phoneDisplay = site_meta?.phone || "09113563040";
const whatsappNum = site_meta?.whatsapp_number || "919113563040";
const addressDisplay = primaryLocation.address || site_meta?.address || "1st Floor, BMN complex, New Airport Rd, Gummanahalli, Bagaluru, Bengaluru, Karnataka 562149";
const hoursDisplay = primaryLocation.hours || "Monday: 4:00 PM – 9:00 PM | Tuesday – Sunday: 9:30 AM – 9:00 PM";
const localAreas = site_meta?.local_areas_served || ["Bagaluru", "Gummanahalli", "New Airport Rd", "Bengaluru"];

// Social Icons SVG mapper
const socialIcons: Record<string, string> = {
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4"><path d="M24 4.557a9.83 9.83 0 01-2.828.775 4.932 4.932 0 002.165-2.724 9.864 9.864 0 01-3.127 1.195 4.916 4.916 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.557z"/></svg>`
};
---

<footer class="bg-japandi-sand/80 border-t border-japandi-clay/50 pt-16 pb-12 px-6 lg:px-24">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-japandi-clay/30 text-xs">
      
      <!-- Brand & Philosophy Column -->
      <div class="space-y-4">
        <a href="/" aria-label="House of Dental Homepage">
          <!-- Light Theme Logo -->
          <img 
            src="/House_of_Dental_Logo_light.png" 
            alt="House of Dental - Premium Dental Clinic" 
            class="footer-logo-light h-20 w-auto object-contain transition-all duration-300" 
            loading="lazy"
            width="200"
            height="80"
          />
          <!-- Dark Theme Logo -->
          <img 
            src="/House_of_Dental_Logo.png" 
            alt="House of Dental - Premium Dental Clinic" 
            class="footer-logo-dark h-20 w-auto object-contain transition-all duration-300" 
            loading="lazy"
            width="200"
            height="80"
          />
        </a>
        <p class="text-japandi-earth font-light leading-relaxed">
          {site_meta?.description || "Calm Mind. Healthy Smile. A modern dental clinic committed to clinical precision, hospital-grade hygiene, transparent pricing, and gentle patient care."}
        </p>
        <div class="flex items-center gap-3 pt-1">
          {social_media && social_media.map((social: any) => (
            <a 
              href={social.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-full bg-japandi-sand border border-japandi-clay/60 text-japandi-earth hover:text-japandi-moss hover:border-japandi-moss transition-colors"
              aria-label={`Follow House of Dental on ${social.platform}`}
              set:html={socialIcons[social.icon as keyof typeof socialIcons] || socialIcons.instagram}
            >
            </a>
          ))}
        </div>
      </div>

      <!-- Treatments Navigation Column -->
      <div class="space-y-3">
        <h4 class="font-serif text-sm font-medium text-japandi-charcoal">Specialized Treatments</h4>
        <ul class="space-y-1.5 text-japandi-earth font-light text-[11px]">
          <li><a href="/treatments/dental-implants" class="hover:text-japandi-moss transition-colors">Dental Implants</a></li>
          <li><a href="/treatments/root-canal-treatment" class="hover:text-japandi-moss transition-colors">Root Canal Treatment</a></li>
          <li><a href="/treatments/clear-aligners" class="hover:text-japandi-moss transition-colors">Clear Aligners</a></li>
          <li><a href="/treatments/teeth-whitening" class="hover:text-japandi-moss transition-colors">Teeth Whitening</a></li>
          <li><a href="/treatments/wisdom-tooth-removal" class="hover:text-japandi-moss transition-colors">Wisdom Tooth Removal</a></li>
          <li><a href="/treatments/pediatric-dentistry" class="hover:text-japandi-moss transition-colors">Pediatric Dentistry</a></li>
          <li><a href="/treatments/tooth-extraction" class="hover:text-japandi-moss transition-colors">Tooth Extraction</a></li>
          <li><a href="/treatments/dental-crowns" class="hover:text-japandi-moss transition-colors">Dental Crowns</a></li>
          <li><a href="/treatments/dental-bridges" class="hover:text-japandi-moss transition-colors">Dental Bridges</a></li>
          <li><a href="/treatments/dentures" class="hover:text-japandi-moss transition-colors">Dentures</a></li>
          <li><a href="/treatments/scaling-and-polishing" class="hover:text-japandi-moss transition-colors">Scaling &amp; Polishing</a></li>
          <li><a href="/treatments/smile-makeover" class="hover:text-japandi-moss transition-colors">Smile Makeover</a></li>
          <li><a href="/treatments/emergency-dentist" class="hover:text-japandi-moss transition-colors font-medium text-red-700">Emergency Dentist</a></li>
        </ul>
      </div>

      <!-- Studio & Legal Resources Column -->
      <div class="space-y-3">
        <h4 class="font-serif text-sm font-medium text-japandi-charcoal">Studio &amp; Legal</h4>
        <ul class="space-y-2 text-japandi-earth font-light text-[11px]">
          <li><a href="/about" class="hover:text-japandi-moss transition-colors">About House of Dental</a></li>
          <li><a href="/contact" class="hover:text-japandi-moss transition-colors">Contact &amp; Clinic Map</a></li>
          <li><a href="/privacy-policy" class="hover:text-japandi-moss transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-japandi-moss transition-colors">Terms &amp; Conditions</a></li>
          <li><a href="/#team" class="hover:text-japandi-moss transition-colors">Our Artisans &amp; Doctors</a></li>
          <li><a href="/blog" class="hover:text-japandi-moss transition-colors">Oral Health Journal</a></li>
          <li><a href="/feedback" class="hover:text-japandi-moss transition-colors">Patient Reviews</a></li>
          <li>
            <a 
              href={site_meta?.google_maps_url || "https://maps.app.goo.gl/dhU4UySs9WFkHAzYA"} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1 hover:text-japandi-moss transition-colors"
            >
              <span>Google Maps Verified Listing</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Canonical NAP (Name, Address, Phone) Contact Column -->
      <div class="space-y-3">
        <h4 class="font-serif text-sm font-medium text-japandi-charcoal">House of Dental</h4>
        <address class="not-italic text-japandi-earth font-light leading-relaxed">
          {addressDisplay}
        </address>
        <div class="pt-1 flex flex-col gap-1.5 font-medium">
          <a 
            href={`tel:${phoneDisplay}`} 
            class="text-japandi-charcoal hover:text-japandi-moss transition-colors inline-flex items-center gap-1.5"
            onclick={`if (typeof gtag_report_conversion !== 'undefined') gtag_report_conversion('tel:${phoneDisplay}');`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Phone: {phoneDisplay}</span>
          </a>
          <a 
            href={`https://wa.me/${whatsappNum}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-japandi-moss hover:text-japandi-charcoal transition-colors inline-flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-3.5 h-3.5">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp: {phoneDisplay}</span>
          </a>
        </div>
        <div class="pt-2 text-[11px] text-japandi-earth font-light leading-relaxed">
          <span class="font-medium text-japandi-charcoal block">Operating Hours:</span>
          <span>{hoursDisplay}</span>
        </div>
      </div>
    </div>

    <!-- Local Dental Care Landing Pages Link Cluster -->
    <div class="py-6 border-b border-japandi-clay/30">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-japandi-charcoal mb-3">
        Local Dental Care &bull; Patient Guides &amp; Area Practices:
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-japandi-earth font-light">
        <a href="/dentist-in-hennur" class="hover:text-japandi-moss transition-colors">Dentist in Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/dentist-in-horamavu" class="hover:text-japandi-moss transition-colors font-medium">Dentist in Horamavu</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/dentist-near-manyata-tech-park" class="hover:text-japandi-moss transition-colors font-medium">Dentist Near Manyata Tech Park</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/emergency-dentist-hennur" class="hover:text-japandi-moss transition-colors font-medium text-red-700">Emergency Dentist Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/dental-clinic-in-hennur" class="hover:text-japandi-moss transition-colors">Dental Clinic in Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/root-canal-treatment-hennur" class="hover:text-japandi-moss transition-colors">Root Canal Treatment Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/dental-implants-hennur" class="hover:text-japandi-moss transition-colors">Dental Implants Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/invisible-aligners-hennur" class="hover:text-japandi-moss transition-colors">Invisible Aligners Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/teeth-whitening-hennur" class="hover:text-japandi-moss transition-colors">Teeth Whitening Hennur</a>
        <span class="text-japandi-clay">&bull;</span>
        <a href="/wisdom-tooth-removal-hennur" class="hover:text-japandi-moss transition-colors">Wisdom Tooth Removal Hennur</a>
      </div>
    </div>

    <!-- Local Catchment Area Citation & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-japandi-earth font-light text-center md:text-left">
      <p class="max-w-2xl leading-relaxed">
        <strong>House of Dental</strong> is conveniently located for patients across <span class="text-japandi-charcoal font-medium">Hennur</span>, <span class="text-japandi-charcoal font-medium">Horamavu</span>, <span class="text-japandi-charcoal font-medium">Manyata Tech Park</span>, <span class="text-japandi-charcoal font-medium">Hennur Bande</span>, <span class="text-japandi-charcoal font-medium">Babusapalya</span>, <span class="text-japandi-charcoal font-medium">Kalyan Nagar</span>, <span class="text-japandi-charcoal font-medium">HRBR Layout</span>, <span class="text-japandi-charcoal font-medium">Kammanahalli</span>, <span class="text-japandi-charcoal font-medium">Banaswadi</span>, <span class="text-japandi-charcoal font-medium">Kothanur</span>, and <span class="text-japandi-charcoal font-medium">North Bengaluru</span>.
      </p>
      <div class="flex items-center gap-3">
        <a href="/privacy-policy" class="hover:text-japandi-moss transition-colors">Privacy</a>
        <span>&bull;</span>
        <a href="/terms-and-conditions" class="hover:text-japandi-moss transition-colors">Terms</a>
        <span>&bull;</span>
        <span>&copy; {new Date().getFullYear()} House of Dental.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  :global(html:not(.dark)) .footer-logo-dark {
    display: none !important;
  }
  :global(html.dark) .footer-logo-light {
    display: none !important;
  }
</style>
