---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { hero_section, site_meta } = config;

// Formulating the WhatsApp deep link
const whatsappBase = "https://wa.me/";
const encodedMessage = encodeURIComponent(site_meta.whatsapp_default_message);
const whatsappUrl = `${whatsappBase}${site_meta.whatsapp_number}?text=${encodedMessage}`;
---

<header id="book" class="relative min-h-[92vh] flex items-center px-4 sm:px-6 lg:px-16 xl:px-24 py-16 sm:py-24 overflow-hidden ambient-glow">
  <!-- Background Video Overlay Container -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <video 
      src={hero_section.video_url} 
      poster="/og-image.jpg"
      autoplay 
      loop 
      muted 
      playsinline
      class="w-full h-full object-cover filter brightness-[0.65] contrast-[0.95]"
      preload="auto"
    >
    </video>
    <!-- Soft calm Japandi overlay for high readability in both light & dark mode -->
    <div class="absolute inset-0 bg-gradient-to-r from-japandi-cream via-japandi-cream/95 to-japandi-sand/80 dark:from-japandi-cream dark:via-japandi-cream/90 dark:to-japandi-sand/70 transition-colors duration-500"></div>
  </div>

  <div class="max-w-7xl mx-auto w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Primary Copy & Actions -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 sm:space-y-8">
        
        <!-- Live Status & Rating Badges -->
        <div class="flex flex-wrap items-center gap-2.5 animate-slow-fade" style="animation-delay: 0.1s;">
          <a 
            href={site_meta.google_maps_url || "https://maps.app.goo.gl/dhU4UySs9WFkHAzYA"} 
            target="_blank" 
            rel="noopener noreferrer" 
            title={`View ${site_meta.review_count || 29} 5-star reviews on Google Maps`}
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-japandi-clay/60 bg-japandi-cream/90 dark:bg-japandi-sand/80 hover:border-japandi-moss text-xs font-semibold text-japandi-moss transition-all duration-300 shadow-sm hover:shadow"
          >
            <span class="flex items-center text-amber-500 text-xs tracking-tight">
              ★ ★ ★ ★ ★
            </span>
            <span class="font-bold text-japandi-charcoal">{site_meta.rating_value ? site_meta.rating_value.toFixed(1) : "5.0"}/5</span>
            <span class="text-japandi-earth font-light">({site_meta.review_count || 29} Verified Google Reviews)</span>
          </a>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-600 bg-gradient-to-r from-emerald-700 via-emerald-800 to-teal-800 text-white text-[11px] font-bold shadow-md shadow-emerald-900/20">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-300 animate-pulse shrink-0"></span>
            <span class="!text-white font-extrabold tracking-wide">Open Today &bull; Sunday &amp; Emergency Appointments</span>
          </div>
        </div>
        
        <!-- Primary H1 Heading for SEO & Calm Identity -->
        <div class="space-y-3 animate-slow-fade opacity-0" style="animation-fill-mode: forwards; animation-delay: 0.2s;">
          <h1 class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-serif text-japandi-charcoal leading-[1.12] font-medium tracking-tight">
            House of Dental <br class="hidden sm:inline" />
            <span class="text-3xl sm:text-4xl md:text-5xl font-light text-japandi-moss font-sans block mt-1.5">
              {hero_section.headline}
            </span>
          </h1>
        </div>
        
        <!-- Calm Subheadline -->
        <p class="text-base sm:text-lg text-japandi-earth max-w-2xl font-light leading-relaxed animate-slow-fade opacity-0" style="animation-fill-mode: forwards; animation-delay: 0.35s;">
          {hero_section.sub_headline}
        </p>

        <!-- Quick Access Dental Treatments (Above the Fold SEO Links) -->
        <div class="w-full pt-1 animate-slow-fade opacity-0" style="animation-fill-mode: forwards; animation-delay: 0.45s;">
          <span class="text-[11px] font-semibold text-japandi-moss uppercase tracking-widest block mb-2.5">
            Specialized Dental Care in Hennur &amp; Horamavu:
          </span>
          <div class="flex flex-wrap gap-2">
            <a 
              href="/treatments/root-canal-treatment" 
              class="px-3.5 py-1.5 rounded-full border border-japandi-clay/60 bg-japandi-cream/80 hover:bg-japandi-moss hover:text-japandi-cream text-xs text-japandi-charcoal font-medium transition-all duration-200"
            >
              Rotary Root Canal (RCT)
            </a>
            <a 
              href="/treatments/dental-implants" 
              class="px-3.5 py-1.5 rounded-full border border-japandi-clay/60 bg-japandi-cream/80 hover:bg-japandi-moss hover:text-japandi-cream text-xs text-japandi-charcoal font-medium transition-all duration-200"
            >
              Titanium Implants
            </a>
            <a 
              href="/treatments/clear-aligners" 
              class="px-3.5 py-1.5 rounded-full border border-japandi-clay/60 bg-japandi-cream/80 hover:bg-japandi-moss hover:text-japandi-cream text-xs text-japandi-charcoal font-medium transition-all duration-200"
            >
              3D Clear Aligners
            </a>
            <a 
              href="/treatments/teeth-whitening" 
              class="px-3.5 py-1.5 rounded-full border border-japandi-clay/60 bg-japandi-cream/80 hover:bg-japandi-moss hover:text-japandi-cream text-xs text-japandi-charcoal font-medium transition-all duration-200"
            >
              Laser Teeth Whitening
            </a>
          </div>
        </div>
        
        <!-- Primary Action Call to Action Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto animate-slow-fade opacity-0" style="animation-fill-mode: forwards; animation-delay: 0.55s;">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal font-medium rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none text-sm tracking-wide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Reserve Appointment</span>
          </button>

          <a 
            href="tel:09113563040"
            onclick="return typeof gtag_report_conversion === 'function' ? gtag_report_conversion('tel:09113563040') : true;"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay/70 bg-japandi-cream/60 hover:bg-japandi-sand text-japandi-charcoal font-medium rounded-full transition-all duration-300 text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call Desk (09113563040)</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Serene Experience Glass Card -->
      <div class="lg:col-span-5 animate-slow-fade opacity-0" style="animation-fill-mode: forwards; animation-delay: 0.5s;">
        <div class="glass-card rounded-[2.5rem] p-7 sm:p-8 soft-glow flex flex-col justify-between space-y-6 relative overflow-hidden">
          
          <!-- Card Header -->
          <div class="flex items-center justify-between border-b border-japandi-clay/35 pb-5">
            <div>
              <span class="text-[10px] uppercase tracking-widest font-semibold text-japandi-moss block">Patient Centric Care</span>
              <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Comfort &amp; Clinical Safety</h3>
            </div>
            <div class="w-10 h-10 rounded-full bg-japandi-moss/10 text-japandi-moss flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
              </svg>
            </div>
          </div>

          <!-- Feature Items Grid -->
          <div class="space-y-4 text-xs">
            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-japandi-cream/70 dark:bg-japandi-sand/50 transition-colors">
              <div class="p-2 rounded-xl bg-japandi-moss/10 text-japandi-moss shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-japandi-charcoal block text-sm">Painless Rotary Endodontics</span>
                <span class="text-japandi-earth font-light leading-relaxed block mt-0.5">Single-sitting root canal treatment with localized anesthesia and precision rotary files.</span>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-japandi-cream/70 dark:bg-japandi-sand/50 transition-colors">
              <div class="p-2 rounded-xl bg-japandi-moss/10 text-japandi-moss shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l5.654-4.654" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-japandi-charcoal block text-sm">100% Sterile Diagnostic Pouches</span>
                <span class="text-japandi-earth font-light leading-relaxed block mt-0.5">Autoclave-sterilized instrument pouches unsealed directly in front of every patient.</span>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-japandi-cream/70 dark:bg-japandi-sand/50 transition-colors">
              <div class="p-2 rounded-xl bg-japandi-moss/10 text-japandi-moss shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h16.5A2.25 2.25 0 0 1 22.5 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 17.25V6.75A2.25 2.25 0 0 1 3.75 4.5Z" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-japandi-charcoal block text-sm">Transparent &amp; 0% Interest EMI</span>
                <span class="text-japandi-earth font-light leading-relaxed block mt-0.5">Flexible monthly plans starting at Rs. 999/month for implants and clear aligners.</span>
              </div>
            </div>
          </div>

          <!-- Bottom Direct Chat Button -->
          <div class="pt-2">
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs flex items-center justify-center gap-2 transition-all shadow-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Instant WhatsApp Consultation</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</header>

