---
import { LOCAL_FAQS } from '../utils/seoSchemas';
---

<section id="faq" class="py-24 px-4 sm:px-6 lg:px-16 xl:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <!-- Subtle decorative line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay/60"></div>

  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16 animate-slow-fade">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/50 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest mb-4">
        Patient Guidance &bull; Common Questions
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-xs sm:text-sm text-japandi-earth font-light mt-3 max-w-xl mx-auto leading-relaxed">
        Clear, honest answers about our procedures, zero-pain rotary endodontics, pricing, and scheduling at House of Dental.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {LOCAL_FAQS.map((faq, index) => (
        <div 
          class="faq-item bg-japandi-sand/35 dark:bg-japandi-sand/20 border border-japandi-clay/45 rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/60 hover:bg-japandi-sand/65 dark:hover:bg-japandi-sand/35 soft-glow"
        >
          <button
            type="button"
            class="faq-toggle w-full px-6 py-5 sm:px-8 sm:py-6 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-question-${index}`}
          >
            <h3 class="text-base sm:text-lg font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors pr-2">
              {faq.question}
            </h3>
            <div class="w-8 h-8 rounded-full bg-japandi-cream/90 dark:bg-japandi-sand border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all duration-300">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke-width="2" 
                stroke="currentColor" 
                class="w-4 h-4 faq-icon transition-transform duration-300 transform"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </div>
          </button>

          <div
            id={`faq-answer-${index}`}
            role="region"
            aria-labelledby={`faq-question-${index}`}
            class="faq-content max-h-0 overflow-hidden transition-all duration-400 ease-in-out px-6 sm:px-8 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed"
          >
            <p class="pb-6 pt-2 border-t border-japandi-clay/25">
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Help Banner -->
    <div class="mt-14 p-7 sm:p-8 rounded-[2rem] bg-japandi-sand/40 dark:bg-japandi-sand/20 border border-japandi-clay/45 text-center flex flex-col sm:flex-row items-center justify-between gap-6 soft-glow">
      <div class="text-left">
        <h4 class="text-base font-serif font-medium text-japandi-charcoal">Have a specific question about your treatment?</h4>
        <p class="text-xs text-japandi-earth font-light mt-1">Our clinical desk is available to assist you over call or WhatsApp.</p>
      </div>
      <div class="flex items-center gap-3 shrink-0 w-full sm:w-auto justify-center">
        <a 
          href="tel:09113563040" 
          onclick="return typeof gtag_report_conversion === 'function' ? gtag_report_conversion('tel:09113563040') : true;"
          class="px-5 py-2.5 rounded-full border border-japandi-moss text-japandi-moss text-xs font-semibold uppercase tracking-wider hover:bg-japandi-moss hover:text-japandi-cream transition-colors"
        >
          Call Desk
        </a>
        <a 
          href="https://wa.me/919113563040?text=Hello%2C%20I%20have%20a%20question%20regarding%20treatments%20at%20House%20of%20Dental." 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function setupFaqAccordions() {
    const items = document.querySelectorAll('.faq-item');

    items.forEach((item) => {
      const toggleBtn = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content') as HTMLElement;
      const icon = item.querySelector('.faq-icon');

      if (!toggleBtn || !content) return;

      // Ensure no duplicate listener
      const newBtn = toggleBtn.cloneNode(true) as HTMLElement;
      toggleBtn.parentNode?.replaceChild(newBtn, toggleBtn);

      newBtn.addEventListener('click', () => {
        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';

        // Close other items for single-open elegance
        items.forEach((otherItem) => {
          if (otherItem !== item) {
            const otherBtn = otherItem.querySelector('.faq-toggle');
            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
            const otherIcon = otherItem.querySelector('.faq-icon');
            if (otherBtn && otherContent) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherContent.style.maxHeight = '0px';
              otherIcon?.classList.remove('rotate-45');
            }
          }
        });

        // Toggle current item
        if (isExpanded) {
          newBtn.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0px';
          icon?.classList.remove('rotate-45');
        } else {
          newBtn.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
          icon?.classList.add('rotate-45');
        }
      });
    });
  }

  setupFaqAccordions();
  document.addEventListener('astro:after-swap', setupFaqAccordions);
</script>
