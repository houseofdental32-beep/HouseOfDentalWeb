---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { doctors_section, show_doctor_images } = config;
---

<section id="team" class="py-24 px-4 sm:px-6 lg:px-16 xl:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-1/3 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay/60"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Header with interactive scrolling hint -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 animate-slow-fade">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/50 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest mb-4">
          Master Artisans &bull; Certified Specialists
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
          {doctors_section.title}
        </h2>
        <p class="text-sm text-japandi-earth font-light mt-2 leading-relaxed">
          {doctors_section.subtitle} Specialist MDS endodontists, implantologists, and cosmetic dental surgeons.
        </p>
      </div>
      
      <!-- Swipe/Scroll Hint -->
      <div class="mt-6 md:mt-0 flex items-center gap-3 text-xs text-japandi-earth font-light">
        <span>Scroll team</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 animate-bounce-horizontal text-japandi-moss">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
        </svg>
      </div>
    </div>

    <!-- Horizontally Scrollable Gallery -->
    <div class="flex gap-6 sm:gap-8 overflow-x-auto no-scrollbar pb-8 snap-x snap-mandatory w-full max-w-full px-1 sm:px-0">
      {doctors_section.team.map((doctor, index) => (
        <div 
          class="flex-shrink-0 w-[85vw] sm:w-[380px] snap-start bg-japandi-sand/40 dark:bg-japandi-sand/20 border border-japandi-clay/45 rounded-[2.5rem] overflow-hidden flex flex-col justify-between hover:bg-japandi-sand/70 dark:hover:bg-japandi-sand/35 transition-all duration-300 soft-glow animate-slow-fade"
          style={`animation-delay: ${index * 0.12}s;`}
        >
          <!-- Image Container with warm tone filter & badge -->
          <div class="relative aspect-[4/4.5] w-full bg-japandi-clay/20 overflow-hidden flex items-center justify-center">
            {show_doctor_images !== false ? (
              <img 
                src={doctor.image_url} 
                alt={`${doctor.name} - ${doctor.role} at House of Dental`}
                loading="lazy"
                width="600"
                height="675"
                class="w-full h-full object-cover filter sepia-[0.12] contrast-[0.98] transition-transform duration-700 hover:scale-105"
              />
            ) : (
              <img src="/House_of_Dental_Logo_light.png" alt="House of Dental Clinic" width="110" height="110" class="h-28 w-auto object-contain opacity-40 dark:invert dark:brightness-125 dark:hue-rotate-180" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-japandi-charcoal/50 via-transparent to-transparent opacity-70"></div>
            
            <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between">
              <span class="inline-block px-3.5 py-1.5 rounded-full bg-japandi-cream/95 dark:bg-japandi-sand/90 backdrop-blur-md text-[10px] font-semibold text-japandi-moss uppercase tracking-widest shadow-sm">
                {doctor.role}
              </span>
            </div>
          </div>

          <!-- Description and Philosophy -->
          <div class="p-7 flex-grow flex flex-col justify-between space-y-6">
            <div>
              <h3 class="text-2xl font-serif text-japandi-charcoal font-medium mb-1">
                {doctor.name}
              </h3>
              <p class="text-xs text-japandi-earth font-medium tracking-wide">
                {doctor.qualifications}
              </p>
            </div>
            
            <div class="pt-5 border-t border-japandi-clay/35">
              <p class="text-xs text-japandi-charcoal font-light italic leading-relaxed">
                "{doctor.philosophy}"
              </p>
            </div>

            <div class="pt-2">
              <button
                type="button"
                data-open-booking
                class="w-full py-2.5 rounded-full border border-japandi-moss/60 hover:bg-japandi-moss hover:text-japandi-cream text-japandi-moss text-xs font-semibold uppercase tracking-wider transition-all duration-300"
              >
                Consult {doctor.name.split(' ')[0]}
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes bounce-horizontal {
    0%, 100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(4px);
    }
  }
  .animate-bounce-horizontal {
    animation: bounce-horizontal 1.2s infinite;
  }
</style>
