---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { doctors_section, show_doctor_images } = config;
---

<section id="team" class="py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-1/3 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Header with interactive scrolling hint -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 animate-slow-fade">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
          {doctors_section.subtitle}
        </p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
          {doctors_section.title}
        </h2>
      </div>
      
      <!-- Swipe/Scroll Hint -->
      <div class="mt-4 md:mt-0 flex items-center gap-3 text-xs text-japandi-earth">
        <span>Scroll to explore</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 animate-bounce-horizontal">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
        </svg>
      </div>
    </div>

    <!-- Horizontally Scrollable Gallery -->
    <div class="flex gap-8 overflow-x-auto no-scrollbar pb-8 snap-x snap-mandatory -mx-6 px-6 sm:mx-0 sm:px-0">
      {doctors_section.team.map((doctor, index) => (
        <div 
          class="flex-shrink-0 w-[85vw] sm:w-[380px] snap-start bg-japandi-sand/45 border border-japandi-clay/45 rounded-[2.5rem] overflow-hidden flex flex-col justify-between hover:bg-japandi-sand hover:border-japandi-clay transition-all duration-300 hover:shadow-lg hover:shadow-japandi-charcoal/5 animate-slow-fade"
          style={`animation-delay: ${index * 0.15}s;`}
        >
          <!-- Image Container with warm tone filter -->
          <div class="relative aspect-[4/4.5] w-full bg-japandi-clay/30 overflow-hidden flex items-center justify-center">
            {show_doctor_images !== false ? (
              <img 
                src={doctor.image_url} 
                alt={`${doctor.name} - ${doctor.role} at House of Dental`}
                loading="lazy"
                width="600"
                height="675"
                class="w-full h-full object-cover filter sepia-[0.15] contrast-[0.98] transition-transform duration-700 hover:scale-105"
              />
            ) : (
              <img src="/House_of_Dental_Logo_light.png" alt="House of Dental Clinic" width="96" height="96" class="h-24 w-auto object-contain opacity-30 dark:invert dark:brightness-125 dark:hue-rotate-180" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-japandi-charcoal/40 via-transparent to-transparent opacity-60"></div>
            
            <div class="absolute bottom-6 left-6 right-6">
              <span class="inline-block px-3 py-1.5 rounded-full bg-japandi-cream/90 backdrop-blur-sm text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
                {doctor.role}
              </span>
            </div>
          </div>

          <!-- Description and Philosophy -->
          <div class="p-8 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-2xl font-serif text-japandi-charcoal font-medium mb-1">
                {doctor.name}
              </h3>
              <p class="text-xs text-japandi-earth font-medium tracking-wide mb-6">
                {doctor.qualifications}
              </p>
            </div>
            
            <div class="pt-6 border-t border-japandi-clay/35">
              <p class="text-xs text-japandi-charcoal font-light italic leading-relaxed">
                "{doctor.philosophy}"
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes bounce-horizontal {
    0%, 100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(4px);
    }
  }
  .animate-bounce-horizontal {
    animation: bounce-horizontal 1.2s infinite;
  }
</style>
