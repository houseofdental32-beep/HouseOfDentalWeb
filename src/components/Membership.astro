---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { membership_section } = config;
---

<section id="membership" class="py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-1/3 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-16 animate-slow-fade">
      <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
        {membership_section.subtitle}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        {membership_section.title}
      </h2>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      {membership_section.plans.map((plan, index) => {
        // Theme styles based on plan
        const isPrivilege = plan.name.includes("Privilege");
        const isRoyalty = plan.name.includes("Royalty");

        let cardClass = "";
        let buttonClass = "";
        let badgeText = "";
        
        if (isRoyalty) {
          // VIP Theme: Dark mode luxury aesthetic
          cardClass = "bg-japandi-charcoal dark:bg-japandi-charcoal/90 text-japandi-cream border border-japandi-earth/40 shadow-xl shadow-japandi-charcoal/10 transform md:translate-y-2";
          buttonClass = "bg-japandi-earth hover:bg-japandi-cream hover:text-japandi-charcoal text-japandi-cream focus:ring-japandi-earth";
          badgeText = "VIP Tier";
        } else if (isPrivilege) {
          // Highlighted Theme: Sage/Moss green theme
          cardClass = "bg-japandi-sand/85 border-2 border-japandi-moss/70 shadow-lg shadow-japandi-moss/5 relative transform md:-translate-y-2 scale-105 z-10";
          buttonClass = "bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream focus:ring-japandi-moss";
          badgeText = "Most Popular";
        } else {
          // Standard Theme: Warm minimalist cream/sand
          cardClass = "bg-japandi-sand/55 hover:bg-japandi-sand border border-japandi-clay/50 shadow-sm hover:shadow-md transform md:translate-y-2";
          buttonClass = "bg-transparent border border-japandi-moss hover:bg-japandi-moss hover:text-japandi-cream text-japandi-moss focus:ring-japandi-moss";
        }

        return (
          <div 
            class={`rounded-[2.5rem] p-8 md:p-10 flex flex-col justify-between transition-all duration-500 animate-slow-fade ${cardClass}`}
            style={`animation-delay: ${index * 0.15}s;`}
          >
            <div>
              {/* Badge */}
              <div class="flex justify-between items-center mb-6">
                <span class={`text-[9px] font-semibold uppercase tracking-widest px-3 py-1 rounded-full ${
                  isRoyalty ? 'bg-japandi-earth/25 text-japandi-earth' :
                  isPrivilege ? 'bg-japandi-moss/20 text-japandi-moss' :
                  'bg-japandi-clay/35 text-japandi-earth'
                }`}>
                  {badgeText || "Annual Plan"}
                </span>
              </div>

              {/* Plan Name */}
              <h3 class={`text-2xl font-serif font-medium mb-4 ${isRoyalty ? 'text-japandi-cream' : 'text-japandi-charcoal'}`}>
                {plan.name}
              </h3>

              {/* Pricing */}
              <div class="flex items-baseline mb-8">
                <span class="text-4xl sm:text-5xl font-serif font-semibold tracking-tight">
                  {plan.price}
                </span>
                <span class={`text-xs ml-2 font-light uppercase tracking-widest ${isRoyalty ? 'text-japandi-cream/70' : 'text-japandi-earth'}`}>
                  / {plan.period}
                </span>
              </div>

              {/* Divider */}
              <div class={`h-[1px] w-full mb-8 ${isRoyalty ? 'bg-japandi-cream/15' : 'bg-japandi-clay/35'}`}></div>

              {/* Features List */}
              <ul class="space-y-4 mb-10">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm">
                    <svg 
                      xmlns="http://www.w3.org/2000/svg" 
                      fill="none" 
                      viewBox="0 0 24 24" 
                      stroke-width="2.5" 
                      stroke="currentColor" 
                      class={`w-4 h-4 mt-0.5 shrink-0 ${isRoyalty ? 'text-japandi-earth' : 'text-japandi-moss'}`}
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                    <span class={`font-light leading-relaxed ${isRoyalty ? 'text-japandi-cream/90' : 'text-japandi-charcoal/90'}`}>
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            {/* Action Button */}
            <a 
              href="#contact" 
              class={`w-full inline-flex items-center justify-center py-4 px-6 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 ${buttonClass}`}
            >
              Select Plan
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>
