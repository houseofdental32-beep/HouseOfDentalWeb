---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { site_meta } = config;
const phoneDisplay = site_meta?.phone || "09113563040";
const whatsappNumber = site_meta?.whatsapp_number || "919113563040";
const defaultMsg = site_meta?.whatsapp_default_message || "Hello, I would like to book an appointment at House of Dental.";
const phoneLink = `tel:${phoneDisplay}`;
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMsg)}`;
---

<div class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-japandi-cream/95 backdrop-blur-md border-t border-japandi-clay/45 px-3 py-2.5 shadow-[0_-8px_30px_rgb(0,0,0,0.06)] flex items-center justify-between gap-2 animate-slow-fade">
  <!-- Call Button -->
  <a 
    href={phoneLink}
    onclick={`return typeof gtag_report_conversion === 'function' ? gtag_report_conversion('${phoneLink}') : true;`}
    class="flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 border border-japandi-moss text-japandi-moss hover:bg-japandi-moss/5 active:bg-japandi-moss/10 font-semibold rounded-full text-[11px] uppercase tracking-wider transition-all duration-300"
    title="Call House of Dental Reception"
    aria-label="Call House of Dental"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-3.5 h-3.5 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
    </svg>
    <span>Call</span>
  </a>

  <!-- WhatsApp Direct Chat Button -->
  <a 
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold rounded-full text-[11px] uppercase tracking-wider transition-all duration-300 shadow-sm shadow-emerald-600/20"
    title="Chat with House of Dental on WhatsApp"
    aria-label="Chat on WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span>WhatsApp</span>
  </a>

  <!-- Book Visit Interactive Modal Trigger Button -->
  <button 
    type="button"
    data-open-booking
    class="flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal active:bg-japandi-charcoal/90 font-semibold rounded-full text-[11px] uppercase tracking-wider transition-all duration-300 shadow-sm shadow-japandi-moss/10"
    aria-label="Book Dental Appointment"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-3.5 h-3.5 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
    </svg>
    <span>Book Visit</span>
  </button>
</div>
