---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { holistic_services } = config;
---

<section id="pricing" class="py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <div id="services" class="absolute -top-12 left-0 pointer-events-none"></div>
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-16 animate-slow-fade">
      <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
        {holistic_services.subtitle}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        {holistic_services.title}
      </h2>
    </div>

    <!-- Responsive Grid of Categories -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {holistic_services.categories.map((category, catIndex) => {
        const isRct = category.title.toLowerCase().includes('root canal');
        return (
          <div 
            class="bg-japandi-sand/55 hover:bg-japandi-sand border border-japandi-clay/50 rounded-[2rem] p-8 flex flex-col justify-between transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-japandi-charcoal/5 animate-slow-fade"
            style={`animation-delay: ${catIndex * 0.15}s;`}
          >
            <div>
              <!-- Category Index & Title -->
              <div class="flex items-center gap-4 mb-8">
                <div class="w-10 h-10 rounded-full bg-japandi-cream border border-japandi-clay flex items-center justify-center text-japandi-moss shrink-0">
                  <span class="text-sm font-semibold">0{catIndex + 1}</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
                  {isRct ? (
                    <a href="/treatments/root-canal-treatment" class="hover:text-japandi-moss transition-colors">
                      {category.title}
                    </a>
                  ) : (
                    category.title
                  )}
                </h3>
              </div>

              <!-- Category Description (Optional) -->
              {category.description && (
                <p class="text-xs font-light text-japandi-earth leading-relaxed mb-6 italic">
                  {category.description}
                </p>
              )}
              
              <!-- Items List -->
              <ul class="space-y-5">
                {category.items.map((item) => {
                  const itemUrl = isRct ? '/treatments/root-canal-treatment' : null;
                  return (
                    <li class="flex items-baseline justify-between group">
                      {itemUrl ? (
                        <a href={itemUrl} class="text-sm text-japandi-charcoal font-light leading-relaxed group-hover:text-japandi-moss transition-colors hover:underline">
                          {item.name}
                        </a>
                      ) : (
                        <span class="text-sm text-japandi-charcoal font-light leading-relaxed group-hover:text-japandi-moss transition-colors">
                          {item.name}
                        </span>
                      )}
                      <span class="flex-grow mx-3 border-b border-dotted border-japandi-clay/70 self-end mb-1.5 opacity-40 group-hover:opacity-100 transition-opacity"></span>
                      <span class="text-sm font-semibold text-japandi-moss shrink-0">
                        {item.price}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>

            {isRct && (
              <div class="mt-8 pt-4 border-t border-japandi-clay/30">
                <a 
                  href="/treatments/root-canal-treatment" 
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-japandi-moss hover:text-japandi-charcoal transition-colors group/link"
                >
                  <span>Explore Painless Single-Sitting RCT</span>
                  <span class="transition-transform group-hover/link:translate-x-1">&rarr;</span>
                </a>
              </div>
            )}
          </div>
        );
      })}
    </div>

    <!-- Comprehensive Clinical Services Hub -->
    <div class="mt-16 pt-12 border-t border-japandi-clay/40">
      <div class="max-w-3xl mb-8">
        <p class="text-xs font-semibold text-japandi-moss uppercase tracking-widest mb-1.5">Specialized Clinical Directory</p>
        <h3 class="text-2xl font-serif text-japandi-charcoal font-medium">Explore All Dental Treatments</h3>
        <p class="text-xs text-japandi-earth font-light mt-1">Detailed clinical guides, transparent pricing, and FAQs for all dental procedures at our Hennur studio:</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 text-xs">
        <a href="/treatments/dental-implants" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Dental Implants &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Permanent titanium &amp; zirconia tooth replacement.</span>
          </div>
        </a>
        <a href="/treatments/root-canal-treatment" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Root Canal Treatment &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Painless single-sitting rotary endodontics.</span>
          </div>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Clear Aligners &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Custom invisible braces &amp; 3D digital orthodontics.</span>
          </div>
        </a>
        <a href="/treatments/teeth-whitening" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Teeth Whitening &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">In-office laser bleaching for radiant smiles.</span>
          </div>
        </a>
        <a href="/treatments/wisdom-tooth-removal" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Wisdom Tooth Removal &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Atraumatic surgical extraction of impacted molars.</span>
          </div>
        </a>
        <a href="/treatments/pediatric-dentistry" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Pediatric Dentistry &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Gentle cavity care, fluoride &amp; sealants for children.</span>
          </div>
        </a>
        <a href="/treatments/tooth-extraction" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Tooth Extraction &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Gentle tooth removal with socket bone preservation.</span>
          </div>
        </a>
        <a href="/treatments/dental-crowns" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Dental Crowns &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">CAD/CAM Zirconia &amp; E-Max high-strength caps.</span>
          </div>
        </a>
        <a href="/treatments/dental-bridges" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Dental Bridges &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Fixed ceramic bridges to replace missing teeth.</span>
          </div>
        </a>
        <a href="/treatments/dentures" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Dentures &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Full, partial, flexible &amp; implant snap-in dentures.</span>
          </div>
        </a>
        <a href="/treatments/scaling-and-polishing" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Scaling &amp; Polishing &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Ultrasonic teeth cleaning &amp; stain removal.</span>
          </div>
        </a>
        <a href="/treatments/smile-makeover" class="p-4 rounded-2xl bg-japandi-sand/40 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-0.5 transition-colors">Smile Makeover &rarr;</span>
            <span class="text-[11px] text-japandi-earth font-light leading-relaxed">Digital Smile Design, porcelain veneers &amp; bonding.</span>
          </div>
        </a>
        <a href="/treatments/emergency-dentist" class="p-4 rounded-2xl bg-red-50/70 hover:bg-red-50 border border-red-200 hover:border-red-400 transition-all group flex flex-col justify-between">
          <div>
            <span class="font-medium text-red-800 group-hover:text-red-900 block mb-0.5 transition-colors">Emergency Dentist &rarr;</span>
            <span class="text-[11px] text-red-700/80 font-light leading-relaxed">Same-day severe pain relief &bull; Open Sundays.</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Footer Note -->
    <p class="text-center text-xs font-light text-japandi-earth italic mt-16 max-w-2xl mx-auto leading-relaxed animate-slow-fade" style="animation-delay: 0.5s;">
      * All prices in INR. Prices are subject to final clinical assessment and may vary with the complexity of the case.
    </p>
  </div>
</section>
