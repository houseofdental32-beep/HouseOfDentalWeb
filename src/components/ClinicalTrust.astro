---
// ClinicalTrust.astro
---

<section id="trust-safety" class="py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-1/4 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-16 animate-slow-fade">
      <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
        Clinical Excellence
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        Clinical Hygiene & Patient Safety
      </h2>
    </div>

    <!-- 3-Column Safety Protocols -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <!-- Card 1 -->
      <div class="bg-japandi-sand/55 hover:bg-japandi-sand border border-japandi-clay/45 rounded-[2rem] p-8 flex flex-col justify-between transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-japandi-charcoal/5 animate-slow-fade" style="animation-delay: 0.1s;">
        <div>
          <div class="w-12 h-12 rounded-full bg-japandi-moss/10 flex items-center justify-center text-japandi-moss mb-6 shrink-0">
            <!-- Shield icon with sparkles -->
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Sterilization Standards</h3>
        </div>
        <p class="text-sm text-japandi-earth font-light leading-relaxed mt-4">
          Multi-Tier Autoclave Sterilization & 100% Sealed Single-Use Diagnostic Kits
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-japandi-sand/55 hover:bg-japandi-sand border border-japandi-clay/45 rounded-[2rem] p-8 flex flex-col justify-between transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-japandi-charcoal/5 animate-slow-fade" style="animation-delay: 0.2s;">
        <div>
          <div class="w-12 h-12 rounded-full bg-japandi-moss/10 flex items-center justify-center text-japandi-moss mb-6 shrink-0">
            <!-- Scan / Diagnostic icon -->
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M12 9v6m3-3H9" />
            </svg>
          </div>
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Low-Radiation Scans</h3>
        </div>
        <p class="text-sm text-japandi-earth font-light leading-relaxed mt-4">
          Advanced Low-Radiation Digital RVG Diagnostic Scans
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-japandi-sand/55 hover:bg-japandi-sand border border-japandi-clay/45 rounded-[2rem] p-8 flex flex-col justify-between transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-japandi-charcoal/5 animate-slow-fade" style="animation-delay: 0.3s;">
        <div>
          <div class="w-12 h-12 rounded-full bg-japandi-moss/10 flex items-center justify-center text-japandi-moss mb-6 shrink-0">
            <!-- Hospital / Room icon -->
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205v9.25m-15-2.25V14a.75.75 0 0 0-.75-.75H2.25M6 9h.008v.008H6V9Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM6 12.75h.008v.008H6v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM6 16.5h.008v.008H6v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
          </div>
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Operatory Suites</h3>
        </div>
        <p class="text-sm text-japandi-earth font-light leading-relaxed mt-4">
          Hospital-Grade Disinfection & Private, Serene Operatory Suites
        </p>
      </div>
    </div>

    <!-- Financing Trust Card -->
    <div class="bg-japandi-sand/40 border border-japandi-clay/40 rounded-[2.5rem] p-8 md:p-12 flex flex-col lg:flex-row gap-8 items-start lg:items-center justify-between hover:bg-japandi-sand/65 transition-all duration-300 animate-slow-fade" style="animation-delay: 0.4s;">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/55 bg-japandi-cream/50 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest mb-5">
          Payment Transparency
        </div>
        <h3 class="text-2xl md:text-3xl font-serif text-japandi-charcoal font-medium mb-4">
          Seamless Payment Options
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          We accept all major Credit Cards, Debit Cards, UPI, and Net Banking. Patients wishing to split payments into monthly installments can seamlessly convert credit card transactions into flexible monthly EMIs directly via their bank's post-payment portal or net banking app.
        </p>
      </div>
      
      <div class="flex flex-wrap gap-4 shrink-0 w-full lg:w-auto pt-4 lg:pt-0">
        <!-- Credit Card EMI Badge -->
        <div class="flex items-center gap-2 px-5 py-3 border border-japandi-clay bg-japandi-cream/65 rounded-full text-xs font-semibold text-japandi-moss uppercase tracking-wider">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-earth">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 8.25h19m-19.008 5.75h3.008m-3.008 3h19.008a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
          </svg>
          Bank Card EMIs
        </div>
        <!-- Digital Modes Badge -->
        <div class="flex items-center gap-2 px-5 py-3 border border-japandi-clay bg-japandi-cream/65 rounded-full text-xs font-semibold text-japandi-moss uppercase tracking-wider">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-earth">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 3.068 1.593 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
          </svg>
          UPI & Digital
        </div>
      </div>
    </div>
  </div>
</section>
