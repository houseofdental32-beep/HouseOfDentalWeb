---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Dental Clinic in Hennur Bangalore | House of Dental";
const pageDescription = "Visit House of Dental, a leading dental clinic in Hennur, Bangalore. Advanced digital X-rays, painless root canals, dental implants & family dentistry.";
const canonicalUrl = "https://aurevadental.com/dental-clinic-in-hennur";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20would%20like%20to%20know%20more%20about%20your%20dental%20clinic%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Dental Clinic in Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "What makes House of Dental different from other dental clinics in Hennur?",
    answer: "House of Dental is built around a tranquil Japandi architectural philosophy combining warm minimalist aesthetics with hospital-grade clinical precision. Unlike noisy, crowded clinics, our studio is sound-damped and free of chemical odors. We utilize computerized local anesthesia, low-radiation digital RVG sensors, Class-B vacuum sterilization, and intraoral cameras so you experience zero anxiety and total transparency throughout your visit."
  },
  {
    question: "What diagnostic technologies are available at your Hennur dental clinic?",
    answer: "Our Hennur studio is outfitted with high-frequency digital X-ray units paired with high-definition RVG sensors, intraoral digital video cameras, computerized apex locators for microscopic root canals, motorized rotary endodontic consoles, ultrasonic dental scalers with micro-tip irrigation, and LED curing systems for durable composite restorations."
  },
  {
    question: "Is House of Dental clinic open on weekends and Sundays?",
    answer: "Yes, House of Dental is fully operational on Sundays from 9:30 AM to 9:00 PM, and on Saturdays from 9:30 AM to 9:00 PM. We understand that working professionals and busy families find weekdays challenging, so our full team of doctors is available throughout the weekend for elective treatments as well as sudden emergencies."
  },
  {
    question: "Do you offer dedicated parking at the clinic?",
    answer: "Yes, ample two-wheeler and four-wheeler patient parking is available directly within the SLV Nilaya building premises on Horamavu Agara Road. Our clinic is located on the 2nd floor and is conveniently accessible."
  },
  {
    question: "What safety and sterilization guidelines are practiced?",
    answer: "We adhere strictly to international CDC and OSHA infection control protocols. All metallic dental instruments undergo ultrasonic pre-cleaning, followed by hermetic sealing in medical sterilization pouches and Class-B autoclave processing at 134°C. Single-use disposable barriers, gloves, masks, and suction tips are discarded after every individual patient."
  },
  {
    question: "Which localities are closest to your dental clinic in Hennur?",
    answer: "We are centrally situated on Horamavu Agara Road near Nayara Petrol Bunk, making us within 5 to 10 minutes of Hennur Bande, Hennur Main Road, Horamavu, Babusapalya, Kalyan Nagar, HRBR Layout, Kammanahalli, Geddalahalli, Kothanur, and Byrathi."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dental Clinic in Hennur</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          State-of-the-Art Smile Studio &bull; Hennur Bande, Bengaluru
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Modern, Calming <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Dental Clinic in Hennur.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Discover a dental experience crafted for tranquility and clinical excellence. At House of Dental, we blend Japanese minimalist design with Scandinavian warmth, creating a restorative sanctuary for root canals, clear aligners, dental implants, and complete family wellness on Horamavu Agara Road.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="Clinic Visit - Hennur"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Clinic Appointment</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-4 border border-japandi-clay hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 bg-japandi-sand/40 hover:bg-japandi-sand cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="pt-4 flex flex-wrap items-center gap-6 text-xs text-japandi-earth border-t border-japandi-clay/30 w-full">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Digital Diagnostic Suite</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Hospital-Grade Autoclave</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Sunday Hours: 9:30 AM – 9:00 PM</span>
          </div>
        </div>
      </div>

      <!-- Facility Overview Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden border border-japandi-clay/60 shadow-xl bg-japandi-sand/30 p-8 space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Studio Infrastructure</span>
            <h3 class="text-2xl font-serif text-japandi-charcoal font-medium">House of Dental Studio, Hennur</h3>
            <p class="text-xs text-japandi-earth leading-relaxed font-light">
              Designed as an urban sanctuary where cutting-edge medical engineering harmonizes with natural earth tones, acoustic dampening, and comfortable ergonomic seating.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3.5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40">
              <span class="block text-xl font-serif text-japandi-moss font-semibold">134°C</span>
              <span class="text-[11px] text-japandi-earth">Vacuum Autoclave Sterility</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40">
              <span class="block text-xl font-serif text-japandi-moss font-semibold">&lt;15s</span>
              <span class="text-[11px] text-japandi-earth">Digital Radiograph RVG Speed</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/40 text-xs text-japandi-charcoal space-y-1">
            <p class="font-medium">Direct Landmark &amp; Parking:</p>
            <p class="text-japandi-earth font-light">2nd Floor, SLV Nilaya, Horamavu Agara Road, Near Nayara Petrol Bunk, Hennur Bande, Bangalore 562149. Dedicated on-site parking.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Dive: Inside House of Dental in Hennur -->
  <section class="py-16 px-6 lg:px-24 bg-japandi-sand/25 border-y border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-12">
      
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          A Dental Clinic in Hennur Designed for Comfort, Precision, and Trust
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          For decades, visiting the dentist was synonymous with clinical white walls, pungent chemical odors, noisy handpieces, and intimidating equipment. When creating House of Dental on Horamavu Agara Road, our objective was clear: transform the dental clinic from a place of dread into a restorative sanctuary where patients feel completely at ease. Every architectural detail—from the soft timber finishes and warm lighting to noise-damped treatment operatory suites—was deliberately selected to soothe the nervous system.
        </p>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          Yet beneath this serene exterior lies one of North Bangalore's most advanced digital dental facilities. Founded by Dr. Shweta Singh, BDS (Clinical Director, The Oxford Dental College, Bangalore) alongside dental surgeon Dr. Agniss Mishra, BDS, our clinic integrates computer-guided technologies that make procedures faster, more biologically conservative, and genuinely pain-free.
        </p>
      </div>

      <!-- Technological Infrastructure Section -->
      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Advanced Diagnostic &amp; Treatment Technology at Our Clinic
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          Accurate diagnosis is the foundation of enduring dental health. We have invested in cutting-edge diagnostic equipment that empowers our clinical team to diagnose micro-pathologies before they escalate into painful emergencies:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">1. High-Frequency Digital RVG Sensor</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              Our clinic utilizes digital Radiovisiography sensors that reduce radiation dose by over 85% compared to antiquated photographic dental film. The images appear within seconds on chairside monitors, allowing micro-fractures, interproximal decay, and bone contours to be magnified with razor-sharp clarity.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">2. High-Definition Intraoral Camera</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              We believe patients should be fully empowered partners in their treatment choices. Our high-definition intraoral camera projects live color views of your teeth directly onto your screen, showing you cracked fillings, plaque margins, or enamel wear before we ever begin treatment.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">3. Motorized Endodontic Rotary Consoles</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              Say goodbye to manual root canal drilling. Our computerized rotary endodontic motors paired with flexible nickel-titanium (NiTi) micro-files clean and shape curved root canals with unmatched speed, smoothness, and precision, preserving maximum natural tooth root structure.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">4. Ultrasonic Piezo Scalers with Micro-Mist</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              Professional prophylaxis and calculus removal at House of Dental is gentle on enamel and gums. Our piezoelectric scalers vibrate at microscopic frequencies with warm water mist, lifting hardened tartar and coffee stains with zero scraping or gum sensitivity.
            </p>
          </div>
        </div>
      </div>

      <!-- Comprehensive Clinical Care Spectrum -->
      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Comprehensive Dental Disciplines Offered Under One Roof
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          Families in Hennur, Horamavu, and Kalyan Nagar no longer need to travel to multiple specialized centers for comprehensive oral health. Our clinic provides end-to-end dental solutions:
        </p>

        <div class="space-y-4 text-sm text-japandi-earth font-light">
          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/root-canal-treatment" class="text-japandi-moss hover:underline">Microscopic Root Canal Therapy &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Specialized single-sitting and multi-sitting root canal procedures to eliminate nerve infection, relieve severe dental toothaches, and salvage natural teeth. Read our dedicated guide on <a href="/root-canal-treatment-hennur" class="text-japandi-moss underline">root canal treatment in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/dental-implants" class="text-japandi-moss hover:underline">Titanium &amp; Zirconia Dental Implants &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Biocompatible root replacements that permanently restore single missing teeth, multiple teeth bridges, or full-mouth All-on-4 restorations with rock-solid stability. Explore our <a href="/dental-implants-hennur" class="text-japandi-moss underline">dental implants in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/clear-aligners" class="text-japandi-moss hover:underline">Digital Orthodontics &amp; Invisible Aligners &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Straighten misaligned teeth, eliminate spacing, and resolve bite irregularities with transparent, removable aligner trays. Read our in-depth resource on <a href="/invisible-aligners-hennur" class="text-japandi-moss underline">invisible aligners in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/teeth-whitening" class="text-japandi-moss hover:underline">Laser Teeth Whitening &amp; Bridal Smile Radiance &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Safe, pH-neutral in-office laser whitening that lightens enamel by 4 to 8 shades in a single 45-minute appointment. See our <a href="/teeth-whitening-hennur" class="text-japandi-moss underline">teeth whitening in Hennur</a> page.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/wisdom-tooth-removal" class="text-japandi-moss hover:underline">Surgical Wisdom Tooth Removal &amp; Impaction Relief &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Atraumatic surgical extraction of impacted third molars, stopping jaw stiffness, recurrent pericoronitis, and root crowding. Discover our <a href="/wisdom-tooth-removal-hennur" class="text-japandi-moss underline">wisdom tooth removal in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/pediatric-dentistry" class="text-japandi-moss hover:underline">Gentle Pediatric Dentistry &amp; Habit Correction &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Compassionate pediatric dental care, pit &amp; fissure sealant coatings, preventive fluoride therapy, and stress-free habit coaching designed to make children love visiting the dentist.
            </p>
          </div>
        </div>
      </div>

      <!-- Infection Control & Hospital Grade Sterilization -->
      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          4-Tier Sterilization Protocol for Uncompromising Patient Safety
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          Infection control is non-negotiable at House of Dental. Our sterilization bay operates under a 4-tier medical-grade protocol matching tertiary hospital standards:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
          <div class="p-4 rounded-xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
            <span class="font-semibold text-japandi-moss uppercase text-[10px] tracking-wider block">Tier 1: Ultrasonic Chemical Decontamination</span>
            <p>Instruments are submerged in broad-spectrum multi-enzyme ultrasonic baths to dissolve biological debris and microbial biofilms.</p>
          </div>
          <div class="p-4 rounded-xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
            <span class="font-semibold text-japandi-moss uppercase text-[10px] tracking-wider block">Tier 2: Hermetic Sealing &amp; Chemical Indicators</span>
            <p>Cleaned tools are sealed inside medical-grade sterilization pouches equipped with multi-parameter steam indicators that change color when full sterility is achieved.</p>
          </div>
          <div class="p-4 rounded-xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
            <span class="font-semibold text-japandi-moss uppercase text-[10px] tracking-wider block">Tier 3: Class-B Fractional Vacuum Autoclaving</span>
            <p>Pouches are autoclaved at 134°C under high vacuum pressure, eliminating 100% of bacterial spores, viruses, and vegetative microorganisms.</p>
          </div>
          <div class="p-4 rounded-xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
            <span class="font-semibold text-japandi-moss uppercase text-[10px] tracking-wider block">Tier 4: Single-Use Chairside Opening</span>
            <p>Sterile pouches are unsealed solely in front of the patient. Dental unit water lines undergo daily chemical shock filtration with zero biofilm risk.</p>
          </div>
        </div>
      </div>

      <!-- Locality Catchment, Transit & Directions -->
      <div class="space-y-4">
        <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Strategic Hennur Location: Effortless Access &amp; Parking
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          Located on the 2nd Floor of SLV Nilaya on Horamavu Agara Road (right beside Nayara Petrol Bunk), our dental clinic offers direct transit convenience:
        </p>
        <ul class="list-disc list-inside text-xs sm:text-sm text-japandi-earth space-y-1.5 font-light">
          <li><strong>Hennur Bande &amp; Geddalahalli:</strong> Under 3 minutes by car or two-wheeler.</li>
          <li><strong>Horamavu &amp; Babusapalya:</strong> Direct access without battling Outer Ring Road ring junctions.</li>
          <li><strong>Kalyan Nagar &amp; HRBR Layout:</strong> A quick 10-minute commute along Hennur Road.</li>
          <li><strong>Kothanur, Byrathi, Thanisandra &amp; Bagalur Road:</strong> Direct, smooth connectivity for North Bengaluru tech corridors.</li>
        </ul>
        <p class="text-sm text-japandi-earth font-light leading-relaxed pt-2">
          Dedicated parking spaces for both four-wheelers and two-wheelers are maintained on the property, providing hassle-free parking even during peak evening hours.
        </p>
      </div>

      <!-- Local Guide Internal Links Cluster -->
      <div class="p-6 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/50 space-y-4">
        <h4 class="font-serif text-base text-japandi-charcoal font-medium">
          Browse Our Local Hennur Dental Specialty Portals:
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-japandi-moss font-medium">
          <a href="/dentist-in-hennur" class="hover:underline">&bull; Dentist in Hennur - Doctor Profiles &amp; Care</a>
          <a href="/root-canal-treatment-hennur" class="hover:underline">&bull; Painless Root Canal Treatment in Hennur</a>
          <a href="/dental-implants-hennur" class="hover:underline">&bull; Permanent Dental Implants in Hennur</a>
          <a href="/invisible-aligners-hennur" class="hover:underline">&bull; Invisible Clear Aligners in Hennur</a>
          <a href="/teeth-whitening-hennur" class="hover:underline">&bull; Professional Teeth Whitening in Hennur</a>
          <a href="/wisdom-tooth-removal-hennur" class="hover:underline">&bull; Wisdom Tooth Extraction in Hennur</a>
          <a href="/contact" class="hover:underline">&bull; Contact &amp; Schedule Appointments</a>
          <a href="/blog" class="hover:underline">&bull; Oral Health &amp; Dental Journal</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Frequently Asked Questions Section -->
  <section class="py-20 px-6 lg:px-24 bg-transparent">
    <div class="max-w-4xl mx-auto space-y-10">
      <div class="text-center space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Patient Clarity</span>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium">
          Frequently Asked Questions About Our Dental Clinic in Hennur
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light max-w-xl mx-auto">
          Clear, honest information regarding our clinic infrastructure, safety protocols, appointment scheduling, and patient amenities.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, idx) => (
          <div class="bg-japandi-sand/40 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="pb-24 px-6 lg:px-24">
    <div class="max-w-4xl mx-auto rounded-3xl bg-japandi-moss text-japandi-cream p-8 sm:p-12 text-center space-y-6 shadow-xl">
