---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Best Dentist in Horamavu Bangalore | Dental Clinic & Emergency Care | House of Dental";
const pageDescription = "Looking for an experienced dentist in Horamavu, Bangalore? House of Dental on Horamavu Agara Rd offers painless RCT, implants, clear aligners & emergency Sunday care.";
const canonicalUrl = "https://aurevadental.com/dentist-in-horamavu";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20am%20looking%20for%20a%20dentist%20in%20Horamavu%20and%20would%20like%20to%20book%20a%20consultation.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Dentist in Horamavu", url: canonicalUrl }
];

const faqs = [
  {
    question: "Where is House of Dental located near Horamavu?",
    answer: "House of Dental is conveniently situated on Horamavu Agara Road itself (2nd Floor, No. 11/4, SLV Nilaya, Horamavu Agara Road, Near Nayara Petrol Bunk, Hennur Bande, Bengaluru 562149). We are merely a 3 to 5-minute drive from Horamavu Ring Road junction, Kalkere, and Jayanthi Nagar, offering dedicated patient parking on site."
  },
  {
    question: "Do you have an emergency dentist for Horamavu residents?",
    answer: "Yes. We offer same-day emergency dentist appointments for acute toothache, cracked or chipped teeth, facial swelling, lost fillings, and trauma. Horamavu patients can call our emergency line at 09113563040 or reach out via WhatsApp for immediate triage and same-day relief."
  },
  {
    question: "Is this dental clinic in Horamavu open on Sundays?",
    answer: "Yes, House of Dental is open on Sundays from 9:30 AM to 9:00 PM. We understand that weekday work and family schedules make dental visits challenging, which is why we provide full diagnostic and clinical services all day Sunday."
  },
  {
    question: "Who are the doctors at House of Dental?",
    answer: "Our clinical director is Dr. Shweta Singh (BDS, The Oxford Dental College, Bangalore; registered with Karnataka State Dental Council), an expert in smile design, restorative care, and cosmetic dentistry. She is joined by Dr. Agniss Mishra (BDS, The Oxford Dental College), dental surgeon with extensive expertise in painless conservative dentistry."
  },
  {
    question: "What treatments are available at your Horamavu dental clinic?",
    answer: "We provide comprehensive oral healthcare: single-sitting painless root canals (RCT), dental implants, clear aligners & invisible braces, laser teeth whitening, ceramic and zirconia crowns, pediatric dental care, and ultrasonic scaling and gum care."
  },
  {
    question: "How do you guarantee painless dental treatment?",
    answer: "We employ modern computerized local anesthesia delivery, ultra-fine gauge needles, digital apex locators, and rotary endodontics. Our tranquil Japandi-inspired studio is designed to minimize anxiety so that your visit is calm, gentle, and pain-free."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dentist in Horamavu</span>
    </div>
  </nav>

  <!-- Hero Header Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Comprehensive Dental Clinic &bull; Horamavu Agara Road, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Modern, Gentle <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Dentist in Horamavu.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Located right on Horamavu Agara Road, House of Dental is the trusted dental clinic for families across Horamavu, Kalkere, Jayanthi Nagar, and Babusapalya. Led by Dr. Shweta Singh and Dr. Agniss Mishra (The Oxford Dental College alumni), we bring hospital-grade sterilization and painless dental care right to your neighborhood.
        </p>

        <!-- Direct Action CTA Buttons (Call, WhatsApp, Book) -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="General Consultation - Horamavu"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Dentist Visit</span>
          </button>

          <a 
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-[#25D366] hover:bg-[#20ba59] text-white text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-emerald-500/20 cursor-none"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.991.564 1.775.814 2.802.814 3.182 0 5.768-2.587 5.768-5.766 0-3.181-2.586-5.766-5.774-5.766zm6.756 5.766c-.001 3.73-3.036 6.764-6.766 6.764-.997 0-1.932-.24-2.774-.698l-3.097.813.827-3.023c-.496-.867-.723-1.85-.723-2.856.001-3.73 3.035-6.764 6.766-6.764 3.731 0 6.767 3.034 6.767 6.764z"/>
            </svg>
            <span>WhatsApp Clinic</span>
          </a>

          <a 
            href={phoneCallUrl}
