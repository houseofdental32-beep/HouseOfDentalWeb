            <span class="font-medium text-japandi-charcoal">Sunday</span>
            <span class="text-japandi-moss font-medium">9:30 AM – 9:00 PM (All Day)</span>
          </div>
          <div class="flex justify-between">
            <span class="font-medium text-japandi-charcoal">Monday</span>
            <span>4:00 PM – 9:00 PM</span>
          </div>
        </div>

        <div class="pt-2 space-y-3">
          <p class="text-xs text-japandi-earth font-light">Have an urgent dental inquiry or acute pain?</p>
          <div class="flex flex-col gap-2">
            <a 
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 bg-[#25D366] text-white text-center rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-[#20ba59] transition-colors"
            >
              Chat on WhatsApp Now
            </a>
            <a 
              href={phoneCallUrl}
              class="w-full py-3 border border-japandi-clay text-japandi-charcoal text-center rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-japandi-sand transition-colors"
            >
              Call 09113563040
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="py-16 px-6 lg:px-24">
    <div class="max-w-4xl mx-auto space-y-8">
      <div class="text-center space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Got Questions?</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal">Frequently Asked Questions</h2>
        <p class="text-sm text-japandi-earth font-light">Everything you need to know about visiting House of Dental from Horamavu.</p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group border border-japandi-clay/50 rounded-2xl p-5 bg-japandi-cream/50 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-medium cursor-pointer text-sm sm:text-base text-japandi-charcoal select-none">
              <span>{faq.question}</span>
              <span class="transition duration-300 group-open:-rotate-180 text-japandi-moss text-xs ml-4">
                &darr;
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed border-t border-japandi-clay/20 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA Bar -->
  <section class="py-14 px-6 lg:px-24 bg-japandi-moss text-japandi-cream text-center">
    <div class="max-w-3xl mx-auto space-y-6">
      <h2 class="text-2xl sm:text-3xl font-serif font-medium">Looking for a Trusted Dentist in Horamavu?</h2>
      <p class="text-sm text-japandi-sand/80 font-light leading-relaxed">
        Experience calm, transparent, and completely painless dental care. Book your consultation today or reach out on WhatsApp for same-day emergency assistance.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <button 
          type="button"
          data-open-booking
          data-treatment="Horamavu Consultation"
          class="px-8 py-4 bg-japandi-cream text-japandi-charcoal hover:bg-japandi-sand text-xs font-semibold uppercase tracking-wider rounded-full transition-all shadow-md cursor-none"
        >
          Book Appointment Online
        </button>
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-4 bg-[#25D366] text-white hover:bg-[#20ba59] text-xs font-semibold uppercase tracking-wider rounded-full transition-all shadow-md cursor-none inline-flex items-center gap-2"
        >
          <span>WhatsApp Us</span>
        </a>
        <a 
          href={phoneCallUrl}
          class="px-7 py-4 border border-japandi-sand/40 text-japandi-cream hover:bg-white/10 text-xs font-semibold uppercase tracking-wider rounded-full transition-all cursor-none"
        >
          Call 09113563040
        </a>
      </div>
    </div>
  </section>
</Layout>
