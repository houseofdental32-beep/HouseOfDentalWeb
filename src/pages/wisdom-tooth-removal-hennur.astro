---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Wisdom Tooth Removal in Hennur | House of Dental";
const pageDescription = "Painless wisdom tooth removal in Hennur, Bangalore at House of Dental. Gentle oral surgery, digital RVG diagnostics & same-day emergency pain relief.";
const canonicalUrl = "https://aurevadental.com/wisdom-tooth-removal-hennur";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20have%20wisdom%20tooth%20pain%20and%20would%20like%20to%20consult%20for%20Removal%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/wisdom-tooth-removal" },
  { name: "Wisdom Tooth Removal Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Is wisdom tooth removal truly painless at House of Dental?",
    answer: "Yes, modern wisdom tooth extraction at House of Dental is virtually painless. We utilize high-potency computerized local anesthetics that ensure deep, profound numbness across the surgical site before touching the tooth. You will feel mild pressure during the procedure, but zero sharp pain."
  },
  {
    question: "What is the recovery time after a wisdom tooth extraction in Hennur?",
    answer: "Most patients return to school or normal desk work within 24 to 48 hours. Soft tissue gum healing occurs over 7 to 10 days. We provide a customized recovery kit with targeted anti-inflammatory medications, an ice pack regimen, and a soft-food guide to minimize facial swelling and ensure rapid biological healing."
  },
  {
    question: "What is the cost of wisdom tooth removal at your Hennur clinic?",
    answer: "At House of Dental, wisdom tooth extraction fees range from Rs. 3,500 to Rs. 9,000 per tooth based on surgical complexity: Simple non-impacted erupted wisdom teeth: Rs. 3,500 to Rs. 5,000; Partially impacted or soft-tissue impactions: Rs. 5,000 to Rs. 7,000; Deep horizontal, angular, or complex bony impactions requiring micro-bone sectioning: Rs. 7,000 to Rs. 9,000. All surgical costs are quoted in writing upfront."
  },
  {
    question: "Do all four wisdom teeth need to be extracted at once?",
    answer: "No. We only recommend removing wisdom teeth that are actively symptomatic, impacted against adjacent healthy molars, triggering recurrent gum infection (pericoronitis), or threatening cyst formation. Depending on your clinical status and personal comfort, we can treat one tooth at a time or address both teeth on one side in a single appointment."
  },
  {
    question: "How do I prevent 'dry socket' after a wisdom tooth extraction?",
    answer: "Dry socket (alveolar osteitis) occurs when the protective blood clot in the extraction socket dislodges prematurely. To prevent dry socket, avoid smoking or tobacco use for at least 72 hours, do not use drinking straws, refrain from vigorous spitting or swishing, and consume only soft, lukewarm foods for the first two to three days."
  },
  {
    question: "Can I get same-day emergency relief for severe wisdom tooth pain in Hennur?",
    answer: "Yes. We maintain emergency appointment slots daily for acute pericoronitis, severe jaw stiffness (trismus), cheek biting, and sudden wisdom tooth infections. Please call our clinic desk at 09113563040 or contact us on WhatsApp for same-day evaluation."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Wisdom Tooth Removal in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "OralSurgery",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/treatments/wisdom-tooth-removal" class="hover:text-japandi-moss transition-colors">Wisdom Tooth Removal</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Hennur</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Oral &amp; Maxillofacial Surgery &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Gentle, Painless <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Wisdom Tooth Removal in Hennur.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Relieve jaw pain, swelling, and impacted molar discomfort safely and gently. At House of Dental on Horamavu Agara Road, our dental surgeons combine low-radiation digital RVG diagnostics, computer-guided local anesthesia, and minimally traumatic surgical techniques in our serene studio environment.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="Wisdom Tooth Consultation - Hennur"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Surgical Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-4 border border-japandi-clay hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 bg-japandi-sand/40 hover:bg-japandi-sand cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="pt-4 flex flex-wrap items-center gap-6 text-xs text-japandi-earth border-t border-japandi-clay/30 w-full">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Atraumatic Surgical Protocol</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Low-Radiation Digital RVG</span>
          </div>
          <div class="flex items-center gap-2">
