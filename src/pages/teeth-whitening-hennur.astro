          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Bridal &amp; Event Packages</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden border border-japandi-clay/60 shadow-xl bg-japandi-sand/30 p-8 space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Cosmetic Brilliance</span>
            <h3 class="text-2xl font-serif text-japandi-charcoal font-medium">In-Office Laser Radiance</h3>
            <p class="text-xs text-japandi-earth leading-relaxed font-light">
              Unlike over-the-counter strips or abrasive charcoal toothpastes that strip protective enamel, our clinical whitening breaks deep stain molecules chemically while preserving your enamel prisms intact.
            </p>
