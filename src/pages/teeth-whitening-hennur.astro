---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Teeth Whitening in Hennur | House of Dental";
const pageDescription = "Professional laser teeth whitening in Hennur, Bangalore at House of Dental. 4 to 8 shades lighter in 45 minutes with zero enamel sensitivity. Call now.";
const canonicalUrl = "https://aurevadental.com/teeth-whitening-hennur";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20would%20like%20to%20book%20a%20consultation%20for%20Teeth%20Whitening%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/teeth-whitening" },
  { name: "Teeth Whitening Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Does professional laser teeth whitening damage enamel?",
    answer: "No. Professional teeth whitening performed at House of Dental uses pH-neutral hydrogen peroxide and carbamide peroxide gels formulated with desensitizing agents (potassium nitrate and fluoride). The blue light wavelength gently oxidizes deep intrinsic chromogens embedded within microscopic enamel pores without eroding, thinning, or softening your protective tooth enamel."
  },
  {
    question: "How many shades lighter can my teeth become in a single session?",
    answer: "Most patients experience a noticeable brightening of 4 to 8 shades on the VITA classical shade guide in a single 45 to 60-minute in-office session. The final shade depends on the baseline severity of staining, enamel mineral density, and whether discoloration stems from food/coffee pigments or internal tetracycline/fluorosis."
  },
  {
    question: "How long do professional teeth whitening results last?",
    answer: "Results typically last 1 to 3 years depending on your dietary and lifestyle habits. Limiting consumption of dark staining beverages like black coffee, tea, and red wine, avoiding tobacco smoking, brushing twice daily, and receiving routine biannual ultrasonic cleanings will maintain your luminous smile indefinitely."
  },
  {
    question: "Will I experience painful tooth sensitivity after whitening?",
    answer: "Our clinical protocol incorporates high-potency gum barrier isolation that shields delicate gingival tissues from contact with active whitening gels. We apply a specialized remineralizing nano-hydroxyapatite desensitizing varnish immediately following the procedure, ensuring zero to minimal transient thermal sensitivity."
  },
  {
    question: "What is the cost of professional teeth whitening in Hennur, Bangalore?",
    answer: "At House of Dental, in-office laser whitening sessions typically range from Rs. 8,000 to Rs. 15,000. We also offer curated bridal and groom smile radiance packages that combine ultrasonic scaling, air polishing, and laser brightening at exclusive package pricing."
  },
  {
    question: "What should I eat immediately after teeth whitening?",
    answer: "We advise following the 'White Diet' for 48 hours following treatment, as your enamel pores remain slightly permeable. Safe foods include steamed rice, white poultry, plain pasta, milk, curd, tofu, cauliflower, and water. Avoid turmeric, curries, soy sauce, coffee, tea, berries, and dark sodas for two full days."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Teeth Whitening in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "CosmeticDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/treatments/teeth-whitening" class="hover:text-japandi-moss transition-colors">Teeth Whitening</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Hennur</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Aesthetic Dentistry &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Safe, Radiant <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Teeth Whitening in Hennur.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Brighten your smile safely by 4 to 8 shades in just 45 minutes. Led by cosmetic director Dr. Shweta Singh (BDS) and our clinical team, House of Dental utilizes gentle, pH-neutral laser bleaching with gingival barrier protection to deliver luminous results with zero enamel sensitivity on Horamavu Agara Road.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="Teeth Whitening Consultation - Hennur"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Whitening Session</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-4 border border-japandi-clay hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 bg-japandi-sand/40 hover:bg-japandi-sand cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
