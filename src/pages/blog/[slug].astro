---
import Layout from '../../layouts/Layout.astro';
import { getBlogPostBySlug, getAllBlogPosts } from '../../data/blogPosts';
import { generateBreadcrumbSchema, generateBlogPostSchema, generateFaqSchema } from '../../utils/seoSchemas';

export const prerender = false;

const { slug } = Astro.params;
const post = getBlogPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/blog');
}

const canonicalUrl = `https://aurevadental.com/blog/${post.slug}`;
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = `https://wa.me/919113563040?text=${encodeURIComponent(`Hi House of Dental, I would like to consult regarding ${post.relatedTreatmentName || post.headline}.`)}`;

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Blog", url: "https://aurevadental.com/blog" },
  { name: post.title, url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const blogPostSchema = JSON.stringify(generateBlogPostSchema({
  headline: post.headline,
  description: post.metaDescription,
  url: canonicalUrl,
  authorName: post.author,
  authorJobTitle: post.authorRole,
  datePublished: post.datePublished,
  dateModified: post.dateModified
}));

const schemaMarkup = [breadcrumbSchema, blogPostSchema];
if (post.faqs && post.faqs.length > 0) {
  schemaMarkup.push(JSON.stringify(generateFaqSchema(post.faqs)));
}

const seoProps = {
  title: post.title,
  description: post.metaDescription,
  canonical: canonicalUrl,
  ogTitle: post.title,
  ogDescription: post.metaDescription,
  ogUrl: canonicalUrl,
  schemaMarkup
};

// Author initials for avatar circle
const authorInitials = post.author.replace(/Dr\.?\s*/i, '').split(/\s+/).map(n => n[0]).slice(0, 2).join('') || 'AD';
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-4xl mx-auto flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-japandi-moss transition-colors">Blog</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium truncate max-w-xs sm:max-w-md">{post.title}</span>
    </div>
  </nav>

  <!-- Article Container -->
  <article class="py-12 md:py-20 px-6 lg:px-24 bg-transparent">
    <div class="max-w-4xl mx-auto">
      
      <!-- Article Header -->
      <header class="space-y-6 pb-10 border-b border-japandi-clay/30 animate-slow-fade">
        <div class="flex items-center gap-3">
          <span class="text-[10px] font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss">
            {post.category}
          </span>
          <span class="text-xs text-japandi-earth font-light">
            {post.readTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight leading-[1.2]">
          {post.headline}
        </h1>

        <!-- Author Byline -->
        <div class="flex items-center gap-4 pt-2">
          <div class="w-12 h-12 rounded-full bg-japandi-moss/15 text-japandi-moss font-serif text-lg font-medium flex items-center justify-center shrink-0 border border-japandi-clay/60">
            {authorInitials}
          </div>
          <div>
            <div class="text-sm font-semibold text-japandi-charcoal">
              By <span class="text-japandi-moss">{post.author}</span>
            </div>
            <div class="text-xs text-japandi-earth font-light">
              {post.authorRole}, House of Dental &bull; Last updated: {post.date}
            </div>
          </div>
        </div>
      </header>

      <!-- Article Body Content -->
      <div class="prose prose-neutral max-w-none pt-10 text-japandi-charcoal font-light leading-relaxed text-base space-y-8">
        
        <!-- Intro Paragraphs -->
        {post.introParagraphs && post.introParagraphs.map((p, pIdx) => (
          <p class={pIdx === 0 ? "text-lg text-japandi-charcoal/90 leading-relaxed font-normal" : "text-base text-japandi-charcoal font-light leading-relaxed"}>
            {p}
          </p>
        ))}

        <!-- Article Sections -->
        {post.sections && post.sections.map((sec) => (
          <section class="pt-6 space-y-4">
            <h2 class="text-2xl sm:text-3xl font-serif font-medium text-japandi-charcoal pt-4 border-t border-japandi-clay/25">
              {sec.heading}
            </h2>

            {sec.paragraphs && sec.paragraphs.map((para) => (
              <p class="text-sm sm:text-base text-japandi-charcoal font-light leading-relaxed">
                {para}
              </p>
            ))}

            {/* Custom Table if present */}
            {sec.table && (
              <div class="overflow-x-auto rounded-3xl border border-japandi-clay/50 bg-japandi-sand/35 my-6">
                <table class="w-full text-left text-xs sm:text-sm">
                  <thead>
                    <tr class="border-b border-japandi-clay/40 bg-japandi-sand/80">
                      {sec.table.headers.map((h, hIdx) => (
                        <th class={`py-4 px-6 font-serif font-medium ${hIdx === 0 ? 'text-japandi-charcoal' : hIdx === 1 ? 'text-japandi-moss' : 'text-japandi-earth'}`}>
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-japandi-clay/20 text-japandi-charcoal font-light">
                    {sec.table.rows.map((row) => (
                      <tr class="hover:bg-japandi-sand/40 transition-colors">
                        {row.map((cell, cIdx) => (
                          <td class={`py-4 px-6 ${cIdx === 0 ? 'font-medium text-japandi-charcoal' : cIdx === 1 ? 'font-semibold text-japandi-moss' : 'text-japandi-earth'}`}>
                            {cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {/* Callout Box if present */}
            {sec.callout && (
              <div class={`p-6 rounded-2xl border text-xs sm:text-sm leading-relaxed space-y-1 my-6 ${
                sec.callout.type === 'warning'
                  ? 'bg-amber-500/10 border-amber-500/30 text-amber-900 dark:text-amber-200'
                  : sec.callout.type === 'tip'
                  ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-900 dark:text-emerald-200'
                  : 'bg-japandi-moss/10 border-japandi-moss/30 text-japandi-charcoal dark:text-japandi-cream'
              }`}>
                <strong class="font-semibold block flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-japandi-moss shrink-0">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
                  </svg>
                  {sec.callout.title}
                </strong>
                <span>{sec.callout.text}</span>
              </div>
            )}

            {/* Bullet Points if present */}
            {sec.bulletPoints && (
              <ul class="list-disc pl-5 text-xs sm:text-sm text-japandi-earth font-light space-y-2 my-4">
                {sec.bulletPoints.map((bp) => (
                  <li>{bp}</li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {/* Conclusion Box */}
        {post.conclusion && (
          <div class="my-8 p-6 rounded-3xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-widest block">Clinical Takeaway</span>
            <p class="text-sm sm:text-base text-japandi-charcoal font-serif font-normal italic leading-relaxed">
              "{post.conclusion}"
            </p>
          </div>
        )}

        {/* Related Treatment Box */}
        {post.relatedTreatmentUrl && (
          <div class="my-8 p-6 rounded-3xl bg-japandi-sand/55 border border-japandi-clay/50 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block">Clinical Service</span>
              <h4 class="font-serif text-lg font-medium text-japandi-charcoal mt-0.5">Explore Our {post.relatedTreatmentName}</h4>
              <p class="text-xs text-japandi-earth font-light mt-1">Read clinical comparisons, case journeys, and digital scan details at our Hennur studio.</p>
            </div>
            <a 
              href={post.relatedTreatmentUrl}
              class="px-5 py-2.5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-colors shrink-0 cursor-none"
            >
              View Treatment Page &rarr;
            </a>
          </div>
        )}

        <!-- FAQs Accordion -->
        {post.faqs && post.faqs.length > 0 && (
          <section class="pt-10 space-y-6">
            <div class="space-y-1">
              <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block">Frequently Asked Questions</span>
              <h3 class="text-2xl sm:text-3xl font-serif font-medium text-japandi-charcoal">
                Clinical Questions &amp; Answers
              </h3>
            </div>

            <div class="space-y-4 not-prose">
              {post.faqs.map((faq) => (
                <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
                  <button
                    type="button"
                    class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
                    aria-expanded="false"
                  >
                    <span class="text-sm sm:text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                      {faq.question}
                    </span>
                    <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                      </svg>
                    </div>
                  </button>
                  <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
                    <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                      {faq.answer}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

      </div>

      <!-- Bottom Consultation Card -->
      <div class="mt-14 p-8 sm:p-10 rounded-[2.5rem] bg-japandi-sand/65 border border-japandi-clay/60 shadow-lg shadow-japandi-charcoal/5 space-y-5 text-center sm:text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss text-[10px] font-semibold uppercase tracking-wider">
          House of Dental Studio &bull; Hennur Bande
        </div>
        
        <h3 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium leading-snug">
          {post.ctaHeadline || "Schedule Your Consultation at House of Dental"}
        </h3>

        <p class="text-sm text-japandi-earth font-light leading-relaxed max-w-2xl">
          {post.ctaText || "Visit House of Dental on Horamavu Agara Road, Hennur Bande. Call 09113563040 or WhatsApp to schedule your clinical consultation."}
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-4">
          <button 
            type="button"
            data-open-booking
            data-treatment={post.relatedTreatmentName || "Blog Consultation"}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-japandi-charcoal text-japandi-cream hover:bg-japandi-moss text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Visit</span>
          </button>

          <a 
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-[#25D366] hover:bg-[#20ba59] text-white text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-emerald-500/20 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp Clinic</span>
          </a>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border border-japandi-clay bg-japandi-cream/80 hover:bg-japandi-cream text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>
      </div>

      <!-- Catchment Footer Note -->
      <div class="mt-12 text-center text-xs text-japandi-earth font-light">
        <p>Conveniently located for patients across Hennur Bande, Horamavu Agara Road, Kalyan Nagar, Babusapalya, Thanisandra, Kothanur, and North Bengaluru.</p>
      </div>

    </div>
  </article>
</Layout>

<script>
  function setupBlogAccordions() {
    const items = document.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const toggle = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content') as HTMLElement;
      const icon = item.querySelector('.faq-icon');
      if (!toggle || !content) return;

      const newBtn = toggle.cloneNode(true) as HTMLElement;
      toggle.parentNode?.replaceChild(newBtn, toggle);

      newBtn.addEventListener('click', () => {
        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
        items.forEach((other) => {
          if (other !== item) {
            const ob = other.querySelector('.faq-toggle');
            const oc = other.querySelector('.faq-content') as HTMLElement;
            const oi = other.querySelector('.faq-icon');
            if (ob && oc) {
              ob.setAttribute('aria-expanded', 'false');
              oc.style.maxHeight = '0px';
              oi?.classList.remove('rotate-45');
            }
          }
        });

        if (isExpanded) {
          newBtn.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0px';
          icon?.classList.remove('rotate-45');
        } else {
          newBtn.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
          icon?.classList.add('rotate-45');
        }
      });
    });
  }

  setupBlogAccordions();
  document.addEventListener('astro:after-swap', setupBlogAccordions);
</script>
