---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Root Canal Treatment in Hennur | House of Dental";
const pageDescription = "Painless single-sitting root canal treatment in Hennur, Bangalore at House of Dental. Rotary endodontics, digital RVG & custom zirconia crowns. Call today.";
const canonicalUrl = "https://aurevadental.com/root-canal-treatment-hennur";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20have%20tooth%20pain%20and%20would%20like%20to%20consult%20for%20Root%20Canal%20Treatment%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/root-canal-treatment" },
  { name: "Root Canal Treatment Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Is root canal treatment really painless at your Hennur clinic?",
    answer: "Yes, absolutely. Root canal treatment at House of Dental is virtually painless. We utilize computerized local anesthesia delivery and topical pre-numbing gels that neutralize the sting of standard injections. With high-precision rotary nickel-titanium instruments and apex locators, we ensure complete pulpal numbness and gentle canal cleaning without pressure or discomfort."
  },
  {
    question: "Can a root canal be completed in a single sitting in Hennur?",
    answer: "Yes. In approximately 70% to 80% of cases where pulpal inflammation has not progressed to acute periapical abscess or active pus drainage, our clinical dental team can complete the entire root canal—cleaning, disinfecting, and hermetic sealing—in a single 45 to 60-minute appointment. Severe or re-treatment infections may require a second visit with medicinal intracanal dressing to ensure complete sterile healing."
  },
  {
    question: "How much does a Root Canal Treatment (RCT) cost at House of Dental in Hennur?",
    answer: "At House of Dental, Root Canal Treatments range from Rs. 4,000 to Rs. 10,000 based on tooth position and complexity: Anterior front teeth (single canal): Rs. 4,000 to Rs. 6,000; Premolars (1–2 canals): Rs. 5,000 to Rs. 8,000; Molars (3–4 canals): Rs. 6,000 to Rs. 10,000. Re-RCT of previously failed procedures starts from Rs. 8,000. Complete transparent pricing is provided in writing before treatment."
  },
  {
    question: "Why is a dental crown necessary after an RCT?",
    answer: "A root canal removes the infected nerve and vascular tissue from inside the tooth, leaving the remaining tooth structure brittle over time. A customized CAD/CAM Zirconia or ceramic crown encapsulates the tooth, restoring normal chewing force and preventing catastrophic tooth fractures or micro-leakage reinfection."
  },
  {
    question: "What are the warning signs that I need an emergency root canal?",
    answer: "Key symptoms include persistent, throbbing toothache that worsens when lying down, intense lingering sensitivity to hot or cold drinks, pain while biting or chewing, localized swelling on the gums resembling a pimple (fistula), or darkened enamel discoloration following dental trauma."
  },
  {
    question: "How do I care for my tooth immediately after a root canal?",
    answer: "Avoid chewing hard or sticky foods on the treated side until your final permanent crown is cemented. Mild tenderness for 24 to 48 hours is completely normal and can be managed easily with standard anti-inflammatory medications prescribed by our dentists. Maintain gentle brushing and warm saline rinses."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Root Canal Treatment in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Endodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/treatments/root-canal-treatment" class="hover:text-japandi-moss transition-colors">Root Canal Treatment</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Hennur</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Micro-Endodontics &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Painless, Single-Sitting <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Root Canal in Hennur.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Save your natural tooth and eliminate severe toothache safely. At House of Dental on Horamavu Agara Road, our dental surgeons combine rotary nickel-titanium instrumentation, digital RVG diagnostics, and computerized anesthesia for a truly stress-free root canal treatment.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="Root Canal Treatment - Hennur"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
