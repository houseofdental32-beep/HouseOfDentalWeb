---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../utils/getConfig';
import { generateBreadcrumbSchema, generateDentistSchema } from '../utils/seoSchemas';

export const prerender = false;

const config = getConfig();

const pageTitle = "Contact Dentist in Hennur Bangalore | House of Dental";
const pageDescription = "Contact House of Dental on Horamavu Agara Road, Hennur Bande, Bangalore. Call 09113563040, WhatsApp, or book online. Open 7 days including Sunday.";
const canonicalUrl = "https://aurevadental.com/contact";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20would%20like%20to%20book%20an%20appointment%20or%20ask%20a%20question.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Contact", url: canonicalUrl }
];

const contactFaqs = [
  {
    question: "Where exactly is House of Dental located?",
    answer: "House of Dental is situated at 1st Floor, BMN complex, New Airport Rd, Gummanahalli, Bagaluru, Bengaluru, Karnataka 562149. We are conveniently accessible from Hennur, Horamavu, Kalyan Nagar, HRBR Layout, Babusapalya, and Kammanahalli."
  },
  {
    question: "Is dedicated parking available for patients?",
    answer: "Yes, dedicated two-wheeler and four-wheeler patient parking is available directly at SLV Nilaya building premises."
  },
  {
    question: "Are you open on Sundays for dental emergencies?",
    answer: "Yes, House of Dental is open on Sundays from 9:30 AM to 9:00 PM. We accommodate same-day emergency appointments for acute toothache, chipped teeth, and trauma triage."
  },
  {
    question: "What is the consultation fee at House of Dental?",
    answer: "Our comprehensive initial examination and consultation fee is Rs. 600, which includes high-resolution digital RVG low-radiation imaging and a personalized treatment roadmap."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": contactFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
});

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Contact & Location</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="pt-16 pb-12 px-6 lg:px-24 bg-transparent">
    <div class="max-w-7xl mx-auto text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest mb-4">
        Hennur Bande &bull; Horamavu Agara Road &bull; Bengaluru
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
        Connect With Our <br class="hidden sm:inline"/>
        <span class="italic text-japandi-moss">Dental Sanctuary.</span>
      </h1>
      <p class="text-sm sm:text-base text-japandi-earth font-light mt-4 leading-relaxed max-w-2xl mx-auto">
        Whether you require a routine dental wellness exam, 3D smile scan, or urgent relief for a toothache, our clinical desk in Hennur is ready to guide you.
      </p>
    </div>
  </section>

  <!-- Contact & Location Grid -->
  <section class="pb-20 px-6 lg:px-24">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Clinic Contact Details -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Main Info Card -->
        <div class="bg-japandi-sand/40 border border-japandi-clay/50 rounded-3xl p-8 space-y-6 shadow-sm">
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-widest text-japandi-moss">Primary Clinic & Smile Studio</span>
            <h2 class="text-2xl font-serif text-japandi-charcoal font-medium mt-1">House of Dental</h2>
            <p class="text-xs text-japandi-earth font-light mt-1">Clinical Director: Dr. Shweta Singh, BDS &bull; Dental Surgeon: Dr. Agniss Mishra, BDS</p>
          </div>

          <div class="space-y-4 text-xs text-japandi-charcoal pt-4 border-t border-japandi-clay/30">
            <!-- Address -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-full bg-japandi-sand border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              </div>
              <div class="leading-relaxed">
                <span class="font-semibold block text-japandi-charcoal">Physical Address:</span>
                <address class="not-italic text-japandi-earth font-light">
                  2nd Floor, No. 11/4, SLV Nilaya,<br/>
                  Horamavu Agara Road, Near Nayara Petrol Bunk,<br/>
                  Hennur Bande, Bengaluru, Karnataka 562149
                </address>
                <span class="inline-block mt-1 text-[11px] text-japandi-moss font-medium">Landmark: Opposite/Near Nayara Petrol Bunk</span>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-full bg-japandi-sand border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
              </div>
              <div>
                <span class="font-semibold block text-japandi-charcoal">Call Reception:</span>
                <a href={phoneCallUrl} class="text-japandi-moss font-semibold hover:underline text-sm">09113563040</a>
                <span class="block text-[11px] text-japandi-earth font-light mt-0.5">Direct clinical triage & emergency support</span>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-full bg-japandi-sand border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.909A2.25 2.25 0 0 1 2.25 6.993V6.75m19.5 0v.243m0-1.06-9 5.541-9-5.541" />
                </svg>
              </div>
              <div>
                <span class="font-semibold block text-japandi-charcoal">Email Desk:</span>
                <a href="mailto:houseofdental32@gmail.com" class="text-japandi-earth hover:text-japandi-moss transition-colors">houseofdental32@gmail.com</a>
              </div>
            </div>

            <!-- Operating Hours -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-full bg-japandi-sand border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
              </div>
              <div>
                <span class="font-semibold block text-japandi-charcoal">Studio Hours:</span>
                <p class="text-japandi-earth font-light leading-relaxed">
                  <strong class="font-medium text-japandi-charcoal">Tuesday &ndash; Sunday:</strong> 9:30 AM &ndash; 9:00 PM<br/>
                  <strong class="font-medium text-japandi-charcoal">Monday:</strong> 4:00 PM &ndash; 9:00 PM<br/>
                  <span class="text-japandi-moss font-medium">Sunday Emergency Appointments Available</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row gap-3">
            <a 
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-all shadow-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>WhatsApp Us</span>
            </a>
            <button 
              type="button"
              data-open-booking
              class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border border-japandi-clay/70 hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider transition-all"
            >
              <span>Book Appointment</span>
            </button>
          </div>
        </div>

        <!-- Neighborhoods Card -->
        <div class="p-6 rounded-3xl bg-japandi-sand/25 border border-japandi-clay/35 text-xs">
          <span class="font-semibold text-japandi-charcoal block mb-2">Local Neighborhoods We Serve:</span>
          <p class="text-japandi-earth font-light leading-relaxed">
            Hennur, Horamavu, Hennur Bande, Babusapalya, Kalyan Nagar, HRBR Layout, Kammanahalli, Banaswadi, Ramamurthy Nagar, Chelekere, Geddalahalli, Kothanur, and North Bengaluru.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Google Map & Appointment Form Card -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Google Maps Embed Container -->
        <div class="bg-japandi-sand/30 border border-japandi-clay/45 rounded-3xl overflow-hidden shadow-sm">
          <div class="p-4 bg-japandi-sand/50 border-b border-japandi-clay/30 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-japandi-moss"></span>
              <span class="text-xs font-medium text-japandi-charcoal">Google Maps Verified Studio</span>
            </div>
            <a 
              href="https://maps.app.goo.gl/dhU4UySs9WFkHAzYA" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-xs text-japandi-moss hover:underline font-medium inline-flex items-center gap-1"
            >
              <span>Open in Google Maps</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
          
          <div class="relative w-full h-[360px] sm:h-[420px] bg-japandi-sand">
            <iframe 
              title="House of Dental Hennur Google Maps Location"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3887.108253139818!2d77.6416031!3d13.0381741!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae17215ca4f107%3A0x8f7d9834125b29bf!2sHouse%20of%20Dental!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              class="filter contrast-[1.02]"
            ></iframe>
          </div>
        </div>

        <!-- Direct Consultation Booking Banner -->
        <div class="p-8 rounded-3xl bg-japandi-moss/10 border border-japandi-moss/20 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="space-y-1 text-center sm:text-left">
            <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Schedule an In-Studio Visit</h3>
            <p class="text-xs text-japandi-earth font-light">Select your preferred date, treatment, and consultation slot.</p>
          </div>
          <button 
            type="button"
            data-open-booking
            class="px-8 py-4 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-all shrink-0 shadow-md shadow-japandi-moss/10"
          >
            Open Appointment Form
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- Location & Patient FAQs Section -->
  <section class="py-16 px-6 lg:px-24 border-t border-japandi-clay/30 bg-japandi-sand/20">
    <div class="max-w-4xl mx-auto space-y-8">
      <div class="text-center space-y-2">
        <span class="text-[10px] uppercase tracking-widest text-japandi-moss font-semibold">Directions & Visit Guidance</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-4">
        {contactFaqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="text-sm sm:text-base font-serif font-medium text-japandi-charcoal">{faq.question}</h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
