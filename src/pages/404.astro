---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const seoProps = {
  title: "Page Not Found | House of Dental Hennur",
  description: "The page you requested does not exist. Return to House of Dental in Hennur, Bangalore to explore our painless treatments and dental care services.",
  canonical: "https://aurevadental.com/404",
  robots: "noindex, follow"
};
---

<Layout {...seoProps}>
  <div class="min-h-[75vh] flex items-center justify-center px-6 py-20 lg:px-24">
    <div class="w-full max-w-2xl bg-japandi-sand/35 border border-japandi-clay/40 rounded-[2.5rem] p-8 md:p-14 text-center space-y-6 shadow-xl shadow-japandi-charcoal/5 animate-slow-fade">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
        404 &bull; Page Not Found
      </div>

      <h1 class="text-3xl sm:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        A Peaceful Pause
      </h1>

      <p class="text-sm sm:text-base text-japandi-earth font-light max-w-lg mx-auto leading-relaxed">
        The page you are looking for has shifted, or the path was typed differently. Let us guide you back to serenity and healthy smiles.
      </p>

      <!-- Treatment Navigation Shortcuts -->
      <div class="pt-4 pb-2">
        <p class="text-xs font-semibold uppercase tracking-widest text-japandi-earth mb-3">
          Explore Popular Treatments
        </p>
        <div class="flex flex-wrap justify-center gap-2 max-w-md mx-auto">
          <a href="/treatments/clear-aligners" class="px-3 py-1.5 rounded-full bg-japandi-sand/80 border border-japandi-clay/60 text-xs text-japandi-charcoal hover:bg-japandi-moss hover:text-japandi-cream transition-colors">
            Clear Aligners
          </a>
          <a href="/treatments/dental-implants" class="px-3 py-1.5 rounded-full bg-japandi-sand/80 border border-japandi-clay/60 text-xs text-japandi-charcoal hover:bg-japandi-moss hover:text-japandi-cream transition-colors">
            Dental Implants
          </a>
          <a href="/treatments/root-canal-treatment" class="px-3 py-1.5 rounded-full bg-japandi-sand/80 border border-japandi-clay/60 text-xs text-japandi-charcoal hover:bg-japandi-moss hover:text-japandi-cream transition-colors">
            Root Canal
          </a>
          <a href="/treatments/teeth-whitening" class="px-3 py-1.5 rounded-full bg-japandi-sand/80 border border-japandi-clay/60 text-xs text-japandi-charcoal hover:bg-japandi-moss hover:text-japandi-cream transition-colors">
            Teeth Whitening
          </a>
          <a href="/blog" class="px-3 py-1.5 rounded-full bg-japandi-sand/80 border border-japandi-clay/60 text-xs text-japandi-charcoal hover:bg-japandi-moss hover:text-japandi-cream transition-colors">
            Oral Health Journal
          </a>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="/" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal font-medium text-xs uppercase tracking-widest rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/10"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
          <span>Return Home</span>
        </a>

        <a 
          href="tel:09113563040" 
          onclick="return typeof gtag_report_conversion === 'function' ? gtag_report_conversion('tel:09113563040') : true;"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-sand/80 hover:bg-japandi-sand border border-japandi-clay text-japandi-charcoal font-medium text-xs tracking-wider rounded-full transition-all duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span>Call Reception Desk</span>
        </a>
      </div>

    </div>
  </div>
</Layout>
