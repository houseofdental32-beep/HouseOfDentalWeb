        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">Smile Makeover FAQs</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
              aria-expanded="false"
            >
              <span class="text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                {faq.question}
              </span>
              <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Treatments & Internal Linking -->
  <section class="py-12 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related Treatments &amp; Aesthetic Solutions</h3>
        <p class="text-xs text-japandi-earth font-light">Explore complementary cosmetic services at our studio:</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/teeth-whitening" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Teeth Whitening &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Instant in-office laser whitening for dazzling smile brightness.</span>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Clear Aligners &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Discreetly align crooked teeth before placing ceramic veneers.</span>
        </a>
        <a href="/treatments/dental-crowns" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Crowns &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Full-coverage E-Max and Zirconia caps for broken teeth.</span>
        </a>
        <a href="/contact" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
