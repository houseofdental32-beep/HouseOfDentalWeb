---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Digital Smile Makeover in Bangalore | Porcelain Veneers | House of Dental";
const pageDescription = "Digital Smile Design, porcelain veneers & aesthetic bonding in Bangalore at House of Dental. Plan your dream smile with our experienced cosmetic dentists.";
const canonicalUrl = "https://aurevadental.com/treatments/smile-makeover";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20a%20Smile%20Makeover%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "What is a Digital Smile Makeover and what does it include?",
    answer: "A smile makeover is a comprehensive, customized aesthetic transformation combining multiple cosmetic dental treatments tailored to your facial proportions. It may include Digital Smile Design (DSD), ultra-thin porcelain or composite veneers, laser gum depigmentation or contouring, teeth whitening, and subtle clear aligner alignment."
  },
  {
    question: "Can I preview my new smile before committing to treatment?",
    answer: "Yes, absolutely! With our 3D Digital Smile Design technology, we capture facial photographs and 3D intraoral scans to create a digital simulation and physical aesthetic wax-up mock-up. You can test-drive your new smile in your own mouth, assessing tooth shape, length, and shade before any clinical preparation begins."
  },
  {
    question: "What is the difference between composite and porcelain veneers?",
    answer: "Composite veneers are hand-sculpted directly in a single visit using aesthetic nano-hybrid resins; they are budget-friendly and minimally invasive (lasting 5 to 7 years). Porcelain/E-Max ceramic veneers are custom-fabricated in specialized dental labs, offering unmatched glass-like translucency, zero staining, and lasting 15 to 20+ years."
  },
  {
    question: "Are smile makeover procedures painful?",
    answer: "Not at all. Most cosmetic procedures like teeth whitening, direct composite bonding, and minimal-prep veneers involve little to no tooth structure reduction and are performed with total comfort under gentle local numbing if required."
  },
  {
    question: "What is the cost of a smile makeover in Hennur, Bangalore?",
    answer: "At House of Dental Hennur, direct composite veneers start from Rs. 4,500 to Rs. 8,000 per tooth. Hand-crafted porcelain and E-Max ceramic veneers range from Rs. 12,000 to Rs. 24,000 per tooth depending on aesthetic customization. Complete bridal, groom, and full-mouth rehabilitation packages are tailored with zero-cost EMI plans."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Smile Makeover", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Digital Smile Makeover & Veneers",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "CosmeticDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
