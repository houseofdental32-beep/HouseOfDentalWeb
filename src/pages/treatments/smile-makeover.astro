          <span class="text-japandi-earth text-[11px]">Schedule your consultation at SLV Nilaya, Horamavu Agara Road.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Catchment Footer Note & Final Callout -->
  <section class="py-14 px-6 lg:px-24 bg-japandi-sand/40 border-t border-japandi-clay/30 text-center">
    <div class="max-w-4xl mx-auto space-y-4">
      <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Design the Confident Smile You Deserve</h3>
