  </section>

  <!-- Smile Elements (H2 Hierarchy) -->
  <section class="py-16 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/20">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">Cosmetic Services</div>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium">Components of Your Bespoke Smile Makeover</h2>
        <p class="text-sm text-japandi-earth font-light">
          We combine cutting-edge aesthetic modalities to create a seamless, balanced smile:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="text-2xl font-serif text-japandi-moss">Porcelain Veneers</div>
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">E-Max Ceramic Shells</h3>
