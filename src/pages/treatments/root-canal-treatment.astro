---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Root Canal Treatment in Bangalore | Single-Sitting RCT | House of Dental";
const pageDescription = "Single-sitting painless root canal treatment (RCT) with rotary endodontics & digital RVG at House of Dental in Bangalore. Save your natural tooth today.";
const canonicalUrl = "https://aurevadental.com/treatments/root-canal-treatment";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20have%20a%20toothache%20and%20would%20like%20to%20consult%20for%20Root%20Canal%20Treatment%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "Is a root canal treatment truly painless?",
    answer: "Yes, modern root canal therapy at House of Dental is virtually painless. With advanced computerized local anesthetics, rotary nickel-titanium instruments, and digital apex locators, the procedure feels very similar to receiving a standard dental filling. We prioritize complete numbness before touching the tooth."
  },
  {
    question: "Can a root canal be completed in a single sitting?",
    answer: "In many cases, yes. If the tooth pulp is inflamed without severe bone abscess or active pus drainage, our dental surgeons can clean, disinfect, and seal the canals in a single 45 to 60-minute appointment. For heavily infected cases, a two-sitting protocol with antibacterial medication ensures maximum biological healing."
  },
  {
    question: "Why do I need a crown after an RCT?",
    answer: "A root canal removes the infected nerve and blood supply from inside the tooth, leaving the remaining natural enamel brittle over time. Placing a high-strength Zirconia or ceramic crown encapsulates the tooth, restoring full chewing force and preventing catastrophic fractures or reinfections."
  },
  {
    question: "What is the cost of a root canal at House of Dental in Bangalore?",
    answer: "At House of Dental, Root Canal Treatments range from Rs. 4,000 to Rs. 10,000 depending on the tooth anatomy (anterior front teeth: Rs. 4,000–Rs. 6,000; premolars: Rs. 5,000–Rs. 8,000; molars with 3–4 canals: Rs. 6,000–Rs. 10,000). Re-RCT of previously failed treatments starts from Rs. 8,000 with complete transparent pricing shared upfront."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Root Canal Treatment", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Painless Root Canal Treatment (RCT)",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Endodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Root Canal Treatment</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Micro-Endodontics &bull; Hennur, Bengaluru
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Painless, Single-Sitting <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Root Canal Treatment (RCT).</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Don't lose your natural tooth. Eliminate toothache safely and gently with precision rotary endodontics, high-magnification clinical illumination, and low-radiation digital radiography in our serene studio.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Emergency Toothache Relief</span>
          </a>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

        <div class="pt-4 flex items-center gap-6 text-xs text-japandi-earth">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Same-Day Emergency Care</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Digital Apex Locator</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Single-Sitting Available</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card -->
      <div class="lg:col-span-5 animate-slow-fade" style="animation-delay: 0.2s;">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 relative">
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">Why Save Your Natural Tooth?</h3>
          
          <ul class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Natural Chewing Sensation:</strong> Nothing feels or functions quite like your biological tooth root and natural periodontal ligament.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Prevents Drifting:</strong> Keeping your tooth stops adjacent teeth from tipping into the empty space.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Cost-Effective Solution:</strong> An RCT and crown is substantially more economical than tooth extraction followed by an implant.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Rotary Endodontic Precision:</strong> Flexible titanium files navigate curved canals smoothly without manual scraping.</div>
            </li>
          </ul>

          <div class="mt-8 pt-6 border-t border-japandi-clay/40 flex items-center justify-between text-xs">
            <span class="text-japandi-earth">Starting RCT Price</span>
            <span class="font-serif text-base font-semibold text-japandi-charcoal">From Rs. 4,000</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 Signs You Need a Root Canal -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Self-Assessment</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          5 Warning Signs You May Need a Root Canal
        </h2>
        <p class="text-sm text-japandi-earth font-light mt-3 leading-relaxed">
          Tooth pain is your body's alarm signal. If bacteria reach the inner pulp chamber, prompt intervention prevents bone infection and saves the tooth.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 hover:shadow-sm transition-all">
          <div class="w-9 h-9 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-xs mb-4">01</div>
          <h4 class="text-sm font-serif font-medium text-japandi-charcoal mb-2">Lingering Sensitivity</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">Pain or sharp zings when consuming hot coffee or cold water that persists for 30+ seconds.</p>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 hover:shadow-sm transition-all">
          <div class="w-9 h-9 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-xs mb-4">02</div>
          <h4 class="text-sm font-serif font-medium text-japandi-charcoal mb-2">Throbbing Chewing Pain</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">Acute pressure or dull throbbing when biting down, eating solid food, or touching the tooth.</p>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 hover:shadow-sm transition-all">
          <div class="w-9 h-9 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-xs mb-4">03</div>
          <h4 class="text-sm font-serif font-medium text-japandi-charcoal mb-2">Gum Swelling & Boil</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">Tender, inflamed gums or a pimple-like bump (gum boil) releasing unpleasant taste or fluid.</p>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 hover:shadow-sm transition-all">
          <div class="w-9 h-9 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-xs mb-4">04</div>
          <h4 class="text-sm font-serif font-medium text-japandi-charcoal mb-2">Deep Cavity / Discoloration</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">Visible dark brown/black hole or a greyish-blue internal discoloration indicating dying nerve pulp.</p>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 hover:shadow-sm transition-all">
          <div class="w-9 h-9 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-xs mb-4">05</div>
          <h4 class="text-sm font-serif font-medium text-japandi-charcoal mb-2">Spontaneous Night Pain</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">Severe unprovoked aches that wake you up at night or radiate to your ear, temple, or jawline.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Rotary Technology & Single-Sitting Options -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Modern Endodontics</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight mb-6">
          Advanced Rotary Endodontics & Electronic Apex Locators
        </h2>
        <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          <p>
            At House of Dental, we have completely retired antiquated hand-filing methods. We utilize <strong class="text-japandi-charcoal font-medium">high-torque motorized rotary endodontic systems</strong> equipped with super-elastic Nickel-Titanium (NiTi) micro-files.
          </p>
          <p>
            These instruments gently conform to the natural curvature of each canal, smoothly eliminating infected bacterial biofilm in a fraction of traditional time without scraping healthy dentin.
          </p>
          <p>
            Our 5th-generation <strong class="text-japandi-charcoal font-medium">Electronic Apex Locators</strong> calculate the precise length of your tooth roots to within 0.1 mm, ensuring zero over-instrumentation and minimal post-treatment sensitivity.
          </p>
        </div>
      </div>

      <!-- Single-Sitting vs Multi-Sitting Card -->
      <div class="bg-japandi-sand/50 border border-japandi-clay/40 rounded-[2.5rem] p-8 sm:p-10">
        <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-6">Single-Sitting vs. Multi-Sitting Protocol</h3>
        
        <div class="space-y-6">
          <div class="p-6 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/30">
            <span class="inline-block px-2.5 py-0.5 rounded-full bg-japandi-moss/10 text-japandi-moss font-semibold text-[10px] uppercase tracking-wider mb-2">Rapid & Efficient</span>
            <h4 class="text-sm font-serif font-medium text-japandi-charcoal">Single-Sitting RCT (45–60 mins)</h4>
            <p class="text-xs text-japandi-earth font-light mt-1 leading-relaxed">
              Recommended for vital inflamed teeth, deep decay without bone pus, or aesthetic cases. Complete instrumentation and thermoplastic root obturation performed in one comfortable session.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/30">
            <span class="inline-block px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-700 font-semibold text-[10px] uppercase tracking-wider mb-2">Deep Biological Disinfection</span>
            <h4 class="text-sm font-serif font-medium text-japandi-charcoal">Multi-Sitting RCT (2 Sessions)</h4>
            <p class="text-xs text-japandi-earth font-light mt-1 leading-relaxed">
              Essential for teeth with chronic periapical abscesses or active fluid seepage. Canal channels are infused with biocompatible calcium hydroxide paste for 7 days to eliminate bacteria before final sealing.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Post-RCT Zirconia & Ceramic Crown Protection -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Long-Term Protection</p>
        <h2 class="text-3xl font-serif text-japandi-charcoal font-medium">Why Every RCT Tooth Needs a Crown</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40">
          <h4 class="font-serif text-base font-medium text-japandi-charcoal mb-2">Restores Fracture Resistance</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Without blood supply, treated enamel becomes brittle. A custom crown hugs the tooth circumferentially, absorbing intense chewing pressures.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40">
          <h4 class="font-serif text-base font-medium text-japandi-charcoal mb-2">Hermetic Bacterial Seal</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Even the best filling can leak microscopic saliva over months. A milled Zirconia crown creates an impenetrable barrier against recurrent decay.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40">
          <h4 class="font-serif text-base font-medium text-japandi-charcoal mb-2">Monolithic Zirconia Strength</h4>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            We utilize 1,200+ MPa multilayered monolithic Zirconia and E.max ceramics that mirror natural enamel light reflection without black gum margins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Item FAQ Accordion -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-2">Patient Guidance</p>
        <h2 class="text-3xl font-serif text-japandi-charcoal font-medium">Root Canal Treatment FAQ</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
              aria-expanded="false"
            >
              <span class="text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                {faq.question}
              </span>
              <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Treatments & Local Care in Hennur -->
  <section class="py-12 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related Treatments &amp; Local Dental Care in Hennur</h3>
        <p class="text-xs text-japandi-earth font-light">Explore complementary restorative and emergency dental treatments at our Hennur studio:</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/dental-implants" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Implants &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Permanent titanium replacements for non-restorable natural teeth.</span>
        </a>
        <a href="/treatments/dental-crowns" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Crowns &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Custom ceramic &amp; zirconia crowns to encapsulate and protect treated teeth.</span>
        </a>
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Hennur RCT Guide &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Local pricing, single-sitting protocols &amp; directions in Hennur.</span>
        </a>
