---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Dental Bridges in Bangalore | Fixed Tooth Replacement | House of Dental";
const pageDescription = "Replace missing teeth with fixed ceramic & zirconia dental bridges at House of Dental in Bangalore. Non-surgical restorative smile restoration.";
const canonicalUrl = "https://aurevadental.com/treatments/dental-bridges";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Dental%20Bridges%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "What is a dental bridge and how does it work?",
    answer: "A dental bridge is a fixed prosthetic device that bridges the gap created by one or more missing teeth. It is anchored onto the natural teeth on either side of the space (abutment teeth) with crowns, suspending an artificial prosthetic tooth (pontic) securely in between."
  },
  {
    question: "What is the difference between a dental bridge and a dental implant?",
    answer: "A dental implant replaces the missing tooth root independently in the jawbone without altering adjacent teeth. A dental bridge relies on shaping the adjacent healthy teeth for support crowns. Bridges are an excellent, rapid, and non-surgical solution for patients who have medical contraindications to surgery or insufficient bone for implants."
  },
  {
    question: "How long does a dental bridge last?",
    answer: "With good oral hygiene, regular dental check-ups, and specialized superfloss cleaning beneath the pontic, high-grade Zirconia and ceramic bridges typically last between 10 to 15+ years."
  },
  {
    question: "How do I clean and maintain a dental bridge?",
    answer: "Maintaining a bridge involves regular twice-daily brushing and cleaning the space beneath the artificial tooth using specialized bridge floss threaders or an oral water flosser. This prevents plaque stagnation and safeguards the supporting abutment teeth."
  },
  {
    question: "What is the cost of dental bridges in Hennur, Bangalore?",
    answer: "At House of Dental Hennur, dental bridge pricing is calculated per unit (tooth). Standard PFM bridge units range from Rs. 4,000 to Rs. 6,000 per unit, while metal-free CAD/CAM Zirconia bridge units range from Rs. 7,000 to Rs. 14,000 per unit depending on the aesthetic warranty tier chosen. A 3-unit bridge replaces one missing tooth."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dental Bridges", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Fixed Dental Bridges & Tooth Replacement",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Prosthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dental Bridges</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Fixed Prosthodontics &bull; Hennur Bande, Bengaluru
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Non-Surgical, Fixed <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Dental Bridges.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Close gaps left by missing teeth without surgical downtime. Our custom-crafted zirconia and ceramic bridges seamlessly match your natural bite alignment, restoring full chewing power and facial structure.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="Dental Bridges Consultation"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
