    </div>
  </section>

  <!-- Bridge Types (H2 Hierarchy) -->
  <section class="py-16 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/20">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">Fixed Bridge Configurations</div>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium">Engineered for Lasting Biomechanical Balance</h2>
        <p class="text-sm text-japandi-earth font-light">
          We offer diverse bridge modalities matched to your specific oral anatomy:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="text-2xl font-serif text-japandi-moss">Traditional Fixed Bridge</div>
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">Two Supporting Crowns</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            The most established fixed restoration, anchored securely on both sides of the gap for maximum load distribution in posterior molars.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="text-2xl font-serif text-japandi-moss">Cantilever Bridge</div>
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">Single-Sided Support</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Utilized when only one adjacent natural tooth is available, carefully engineered to avoid torque stresses on the supporting abutment.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="text-2xl font-serif text-japandi-moss">Implant-Supported Bridge</div>
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">Multiple Missing Teeth</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Suspends three to four replacement teeth across just two titanium dental implants, eliminating the need to prepare healthy natural teeth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Local Area Targeting Section -->
  <section class="py-14 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/20">
    <div class="max-w-7xl mx-auto space-y-6">
      <div class="max-w-3xl space-y-2">
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">Custom Dental Bridges in Hennur &amp; North Bangalore</h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Conveniently located for patients in Hennur Bande, Horamavu Agara Road, Kalyan Nagar, HRBR Layout, Banaswadi, Kammanahalli, Babusapalya, and Kothanur. House of Dental offers computerized shade matching, digital scanning, and EMI payment options for all restorative bridge treatments.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="py-16 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/20">
    <div class="max-w-4xl mx-auto space-y-8">
      <div class="space-y-2 text-center">
        <div class="text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">Frequently Asked Questions</div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">Dental Bridge FAQs</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
              aria-expanded="false"
            >
              <span class="text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                {faq.question}
              </span>
              <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Treatments & Internal Linking -->
  <section class="py-12 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related Treatments &amp; Tooth Replacement</h3>
        <p class="text-xs text-japandi-earth font-light">Explore missing tooth options at our Hennur clinic:</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/dental-implants" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Implants &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Compare surgical implants with fixed tooth bridges.</span>
        </a>
        <a href="/treatments/dental-crowns" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Crowns &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Individual porcelain &amp; zirconia caps for weakened teeth.</span>
        </a>
        <a href="/treatments/dentures" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dentures &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Removable partial &amp; complete prosthetics for multiple teeth.</span>
        </a>
        <a href="/contact" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Contact Clinic &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Visit us at Horamavu Agara Road near Nayara Petrol Bunk.</span>
        </a>
      </div>
