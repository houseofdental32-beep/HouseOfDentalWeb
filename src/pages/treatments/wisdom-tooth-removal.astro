---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Painless Wisdom Tooth Removal in Bangalore | Oral Surgery | House of Dental";
const pageDescription = "Painless wisdom tooth removal & surgical disimpaction in Bangalore at House of Dental. Digital RVG diagnostics & same-day emergency toothache relief.";
const canonicalUrl = "https://aurevadental.com/treatments/wisdom-tooth-removal";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20have%20wisdom%20tooth%20pain%20and%20would%20like%20to%20consult%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "Is wisdom tooth removal painful?",
    answer: "No. Modern wisdom tooth extraction at House of Dental is virtually painless. We administer targeted, high-potency local anesthetics that ensure profound numbness across the entire surgical site before touching the tooth. You will feel mild pressure during the procedure, but zero sharp pain."
  },
  {
    question: "How long is the recovery time after a wisdom tooth extraction?",
    answer: "Most patients return to school or normal desk work within 24 to 48 hours. Complete gum healing occurs within 1 to 2 weeks. We prescribe specialized anti-inflammatory medications, an ice pack regimen, and a soft-food guide to minimize post-operative swelling and ensure a rapid, uneventful recovery."
  },
  {
    question: "Do all four wisdom teeth need to be extracted at once?",
    answer: "Not necessarily. We only recommend extracting wisdom teeth that are actively causing pain, impacted against adjacent healthy molars, infected (pericoronitis), or threatening cyst formation. Depending on your preference and clinical diagnostics, we can treat one tooth at a time or remove both on one side in a single appointment."
  },
  {
    question: "What is the cost of wisdom tooth removal at House of Dental in Bangalore?",
    answer: "At House of Dental, simple erupted tooth extractions range from Rs. 1,500 to Rs. 3,500. Surgical extractions for partially or fully impacted horizontal wisdom molars range between Rs. 4,500 and Rs. 9,000 depending on angulation and proximity to the mandibular nerve canal. Complete transparent pricing is shared upfront after reviewing your digital RVG X-ray."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Wisdom Tooth Removal", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Wisdom Tooth Removal & Oral Surgery",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "OralSurgery",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Wisdom Tooth Removal</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Oral Surgery &bull; Hennur, Bengaluru
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Painless Wisdom Tooth <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Extraction &amp; Relief.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Relieve jaw pain, swelling, and impacted molar discomfort safely and gently. Experience digital low-radiation RVG diagnostics, computer-guided local numbness, and minimally traumatic surgical techniques in our serene studio.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="Wisdom Tooth Removal & Oral Surgery"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Emergency Pain Relief Slot</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

        <div class="pt-4 flex items-center gap-6 text-xs text-japandi-earth">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Same-Day Appointments</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Profound Numbness</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Minimal Swelling Protocol</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card -->
      <div class="lg:col-span-5 animate-slow-fade" style="animation-delay: 0.2s;">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-40 h-40 bg-japandi-moss/10 rounded-full blur-2xl pointer-events-none"></div>
          
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">Signs You May Need Removal</h3>
          
          <ul class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Throbbing Jaw Pain:</strong> Persistent aching near the back corners of your mouth or radiating into the ear.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Swollen Gums (Pericoronitis):</strong> Tender, red gum flaps covering partially erupted molars that trap food and bacteria.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Damage to Adjacent Molars:</strong> Horizontal impactions that push into and decay the second molar roots.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Difficulty Chewing or Opening Jaw:</strong> Stiffness in the temporomandibular joint caused by acute inflammation.</div>
            </li>
          </ul>

          <div class="mt-8 pt-6 border-t border-japandi-clay/40 flex items-center justify-between text-xs">
            <span class="text-japandi-earth">Average Duration</span>
            <span class="font-serif text-base font-semibold text-japandi-charcoal">30 – 45 Minutes</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Surgical Precision & Technology -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Surgical Standards</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Atraumatic Surgical Precision
        </h2>
        <p class="text-sm text-japandi-earth font-light mt-3 leading-relaxed">
          We use gentle surgical protocols designed to preserve surrounding jawbone and soft tissues, resulting in significantly less post-operative swelling, less bruising, and faster healing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-3xl p-8 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-sm mb-6">01</div>
          <h3 class="text-lg font-serif text-japandi-charcoal font-medium mb-3">High-Definition Digital RVG</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Precise low-radiation radiography maps exact tooth root curvature and nerve canal depth before touching the tooth.
          </p>
        </div>

        <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-3xl p-8 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-sm mb-6">02</div>
          <h3 class="text-lg font-serif text-japandi-charcoal font-medium mb-3">Deep Local Anesthesia</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Advanced nerve blocks ensure complete surgical area numbness so you remain calm and relaxed throughout the visit.
          </p>
        </div>

        <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-3xl p-8 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss font-semibold text-sm mb-6">03</div>
          <h3 class="text-lg font-serif text-japandi-charcoal font-medium mb-3">Dissolvable Sutures &amp; Care</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            We use fine absorbable sutures that dissolve naturally without uncomfortable suture removal appointments.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Step Extraction Journey -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-14">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Treatment Steps</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          The 4-Step Comfort Protocol
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-japandi-sand/45 border border-japandi-clay/40 rounded-3xl p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Step 01</span>
            <h3 class="text-base font-serif text-japandi-charcoal font-medium mb-2">RVG Scan &amp; Diagnosis</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We evaluate root curvature, nerve proximity, and bone density to plan an atraumatic removal.
            </p>
          </div>
          <div class="mt-6 text-[11px] text-japandi-earth font-medium pt-3 border-t border-japandi-clay/25">Step 1</div>
        </div>

        <div class="bg-japandi-sand/45 border border-japandi-clay/40 rounded-3xl p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Step 02</span>
            <h3 class="text-base font-serif text-japandi-charcoal font-medium mb-2">Targeted Numbing</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We apply topical numbing jelly followed by gentle local anesthesia until you feel zero sensation.
            </p>
          </div>
          <div class="mt-6 text-[11px] text-japandi-earth font-medium pt-3 border-t border-japandi-clay/25">Step 2</div>
        </div>

        <div class="bg-japandi-sand/45 border border-japandi-clay/40 rounded-3xl p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Step 03</span>
            <h3 class="text-base font-serif text-japandi-charcoal font-medium mb-2">Gentle Extraction</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              The impacted tooth is gently mobilized and delivered in sections to avoid unnecessary bone removal.
            </p>
          </div>
          <div class="mt-6 text-[11px] text-japandi-earth font-medium pt-3 border-t border-japandi-clay/25">Step 3</div>
        </div>

        <div class="bg-japandi-sand/45 border border-japandi-clay/40 rounded-3xl p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Step 04</span>
            <h3 class="text-base font-serif text-japandi-charcoal font-medium mb-2">Rapid Recovery Kit</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We clean the socket, place antibacterial gauze, and provide an aftercare kit for smooth healing.
            </p>
          </div>
          <div class="mt-6 text-[11px] text-japandi-earth font-medium pt-3 border-t border-japandi-clay/25">Step 4</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Transparency -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-5xl mx-auto bg-japandi-sand/50 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-12">
      <div class="max-w-2xl mb-8">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-2">Honest Pricing</p>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Tooth Extraction &amp; Surgery Pricing
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
        <div class="space-y-4">
          <p>
            Pricing depends strictly on biological complexity, tooth position, and whether surgical sectioning is required:
          </p>
          <ul class="space-y-2 list-disc pl-5">
            <li><strong class="text-japandi-charcoal font-medium">Simple Tooth Extraction:</strong> Rs. 1,500 – Rs. 3,500</li>
            <li><strong class="text-japandi-charcoal font-medium">Surgical Wisdom Tooth Removal:</strong> Rs. 4,500 – Rs. 8,500</li>
            <li><strong class="text-japandi-charcoal font-medium">Complex/Deep Impacted Molar Surgery:</strong> Rs. 7,000 – Rs. 10,000</li>
            <li><strong class="text-japandi-charcoal font-medium">Digital RVG X-Ray &amp; Consultation:</strong> Rs. 600</li>
          </ul>
        </div>

        <div class="bg-japandi-cream/80 border border-japandi-clay/40 rounded-2xl p-6 flex flex-col justify-between">
          <div>
            <h4 class="text-sm font-serif font-medium text-japandi-charcoal mb-2">Emergency Pain Relief</h4>
            <p class="text-xs text-japandi-earth font-light mb-4">
              Suffering from acute jaw swelling or wisdom toothache? We accommodate same-day urgent care appointments 7 days a week.
            </p>
          </div>
          <button 
            type="button"
            data-open-booking
            data-treatment="Wisdom Tooth Removal & Oral Surgery"
            class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-colors cursor-none"
          >
            Request Emergency Slot
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Item FAQ Accordion -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-2">Clear Answers</p>
        <h2 class="text-3xl font-serif text-japandi-charcoal font-medium">Wisdom Tooth FAQ</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
              aria-expanded="false"
            >
              <span class="text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                {faq.question}
              </span>
              <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Treatments & Local Care in Hennur -->
  <section class="py-12 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related Treatments &amp; Local Dental Care in Hennur</h3>
        <p class="text-xs text-japandi-earth font-light">Explore complementary restorative and surgical care at our Hennur studio:</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/emergency-dentist" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Emergency Dentist &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Same-day relief for acute pericoronitis, facial swelling &amp; urgent toothaches.</span>
        </a>
        <a href="/treatments/tooth-extraction" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Tooth Extraction &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Gentle atraumatic extractions &amp; bone socket preservation in Hennur.</span>
        </a>
        <a href="/wisdom-tooth-removal-hennur" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Hennur Wisdom Surgery &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Local pricing, impaction types &amp; emergency relief in Hennur.</span>
        </a>
        <a href="/contact" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Contact Clinic &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Get driving directions, clinic map &amp; parking info on Horamavu Agara Rd.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Catchment Footer Note & Final Callout -->
  <section class="py-14 px-6 lg:px-24 bg-japandi-sand/40 border-t border-japandi-clay/30 text-center">
    <div class="max-w-4xl mx-auto space-y-4">
      <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Don't Suffer in Silence with Wisdom Tooth Pain</h3>
      <p class="text-xs text-japandi-earth font-light max-w-xl mx-auto leading-relaxed">
        Conveniently located for patients across Hennur Bande, Horamavu Agara Road, Babusapalya, Kalyan Nagar, and North Bengaluru.
      </p>
      <div class="pt-3 flex items-center justify-center gap-3">
        <a 
          href={phoneCallUrl}
