---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Custom Dentures in Bangalore | Full & Partial Dentures | House of Dental";
const pageDescription = "Custom complete, partial & flexible dentures in Bangalore at House of Dental. Natural aesthetics, comfortable fit and stable bite restoration.";
const canonicalUrl = "https://aurevadental.com/treatments/dentures";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Dentures%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "What types of dentures are available at House of Dental?",
    answer: "We offer complete dentures (for patients missing all teeth in an arch), cast partial dentures (with high-strength metal frameworks), ultra-lightweight flexible Valplast dentures (metal-free and tissue-blending), and implant-supported overdentures that snap firmly into titanium implants for zero slippage."
  },
  {
    question: "Will my dentures slip or feel loose when speaking or eating?",
    answer: "No. We utilize multi-stage border molding and anatomical functional impressions to achieve an airtight peripheral seal against the gum tissues. For patients seeking maximum stability without adhesive pastes, implant-retained snap-on dentures offer 100% security."
  },
  {
    question: "How long does it take to get used to new dentures?",
    answer: "Most patients adapt within 1 to 3 weeks. During the first few days, speech and eating soft foods will feel slightly different as your facial muscles adjust. We schedule complimentary post-insertion follow-up reviews to make micro-adjustments and eliminate any pressure points."
  },
  {
    question: "Should I wear my dentures while sleeping?",
    answer: "We advise removing your dentures at night to give your gum tissues and alveolar bone a rest from chewing pressure. Soaking them overnight in a clean, antimicrobial denture cleanser bath keeps them hydrated and free from bacterial plaque accumulation."
  },
  {
    question: "What is the cost of dentures in Hennur, Bangalore?",
    answer: "At House of Dental Hennur, standard acrylic complete dentures range from Rs. 18,000 to Rs. 35,000 per arch. Premium high-impact BPS (Biofunctional Prosthetic System) dentures range from Rs. 40,000 to Rs. 75,000 per arch. Flexible partial dentures (Valplast) start from Rs. 8,000 to Rs. 22,000 depending on the number of missing teeth. Transparent pricing is shared upfront."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dentures", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Custom Full & Partial Dentures",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Prosthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
