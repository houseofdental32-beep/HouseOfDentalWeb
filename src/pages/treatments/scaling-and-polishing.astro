---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Teeth Cleaning & Scaling in Bangalore | House of Dental";
const pageDescription = "Gentle ultrasonic teeth cleaning, scaling & stain polishing in Bangalore at House of Dental. Prevent gum disease & refresh your breath today.";
const canonicalUrl = "https://aurevadental.com/treatments/scaling-and-polishing";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20book%20a%20Scaling%20and%20Polishing%20session%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "Does scaling weaken enamel or create gaps between teeth?",
    answer: "No, this is a common dental myth. Ultrasonic scaling uses high-frequency micro-vibrations and water spray to shatter hardened bacterial tartar (calculus) without scratching or eroding natural tooth enamel. The 'gaps' patients sometimes feel after cleaning were previously packed with inflamed calculus deposits that caused gingival recession."
  },
  {
    question: "How often should I get professional scaling and polishing done?",
    answer: "The Indian Dental Association and international dental protocols recommend professional scaling every 6 months. For patients undergoing orthodontic aligner treatment, smokers, or those with active periodontal gum disease, quarterly (every 3 to 4 months) hygiene reviews are advised."
  },
  {
    question: "Will my teeth be sensitive after the cleaning procedure?",
    answer: "Mild, transient sensitivity to cold water is completely normal for 24 to 48 hours following removal of thick calculus sheets, especially if your roots were previously exposed. We apply a soothing desensitizing fluoride varnish at the end of every cleaning session to protect your enamel."
  },
  {
    question: "What is the difference between scaling and teeth whitening?",
    answer: "Scaling cleans the teeth by eliminating bacterial plaque, calcified tartar, and extrinsic surface stains caused by coffee, tea, and tobacco. Teeth whitening is a cosmetic bleaching treatment that penetrates deep inside enamel and dentin to lighten internal yellow discoloration by several shades."
  },
  {
    question: "What is the cost of teeth scaling and polishing in Hennur, Bangalore?",
    answer: "At House of Dental Hennur, routine ultrasonic scaling and prophy polishing ranges from Rs. 1,200 to Rs. 2,500. Advanced deep subgingival scaling or periodontal root planing for heavy calculus and swollen bleeding gums ranges from Rs. 2,500 to Rs. 5,000 across all four quadrants."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Scaling & Polishing", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Ultrasonic Scaling & Dental Polishing",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Periodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
