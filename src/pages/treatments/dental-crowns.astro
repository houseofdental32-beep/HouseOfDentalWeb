---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Dental Crowns & Caps in Bangalore | Zirconia & E-Max | House of Dental";
const pageDescription = "High-strength Zirconia & E-Max dental crowns in Bangalore at House of Dental. Custom shaded, fracture-resistant restorations for damaged teeth.";
const canonicalUrl = "https://aurevadental.com/treatments/dental-crowns";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Dental%20Crowns%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "Why do I need a dental crown after a Root Canal Treatment?",
    answer: "A root canal removes the infected nerve and blood supply, leaving the tooth structure brittle and prone to catastrophic vertical fracture during normal chewing. A custom CAD/CAM crown encases the entire tooth like a protective helmet, restoring 100% of its bite strength and sealing it against recurrent bacterial infection."
  },
  {
    question: "What is the difference between Zirconia and E-Max crowns?",
    answer: "Zirconia is an ultra-strong crystalline ceramic known for exceptional fracture resistance (exceeding 1200 MPa), making it ideal for molars subjected to heavy chewing forces. E-Max (lithium disilicate) offers unmatched translucency and lifelike light transmission, making it the premier aesthetic choice for front anterior teeth."
  },
  {
    question: "How long do modern dental crowns last?",
    answer: "With routine brushing, flossing, and biannual dental reviews, high-grade Zirconia and E-Max crowns routinely last 15 to 20+ years. Many of our premium zirconia restorations include 10 to 15-year manufacturer warranties against chipping or breakage."
  },
  {
    question: "Does getting a dental crown hurt?",
    answer: "Not at all. The tooth preparation procedure is performed under precise local anesthesia, ensuring total comfort throughout the visit. We use digital intraoral impressions, eliminating uncomfortable traditional putty trays and gagging."
  },
  {
    question: "What is the cost of dental crowns in Hennur, Bangalore?",
    answer: "At House of Dental Hennur, high-strength PFM (Porcelain-Fused-to-Metal) crowns start from Rs. 4,000 to Rs. 6,500. Monolithic CAD/CAM Zirconia crowns range from Rs. 7,000 to Rs. 15,000 depending on warranty tiers (5-yr, 10-yr, or 15-yr). Premium multilayered E-Max aesthetic crowns range from Rs. 10,000 to Rs. 18,000. All options include digital shade-matching."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dental Crowns", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Dental Crowns & Aesthetic Caps",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Prosthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
