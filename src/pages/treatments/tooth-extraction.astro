---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Painless Tooth Extraction in Bangalore | House of Dental";
const pageDescription = "Gentle tooth extractions & socket bone preservation in Bangalore at House of Dental. Atraumatic oral surgery by experienced dental surgeons.";
const canonicalUrl = "https://aurevadental.com/treatments/tooth-extraction";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20need%20a%20consultation%20for%20Tooth%20Extraction%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "Is tooth extraction painful at House of Dental?",
    answer: "No. At House of Dental, we prioritize complete patient comfort. We administer modern, high-potency local anesthesia with micro-fine needles to completely numb the nerve supply of the tooth before starting. You will feel gentle pressure as the tooth is elevated, but zero sharp pain or discomfort."
  },
  {
    question: "When is a tooth extraction absolutely necessary?",
    answer: "Our primary clinical philosophy is conservative tooth preservation. However, extraction becomes essential when a tooth has severe root fractures beyond repair, extensive unrestorable dental decay below the bone margin, advanced periodontal mobility with catastrophic bone loss, or severe crowding requiring orthodontic space."
  },
  {
    question: "How long does it take to recover after a tooth extraction?",
    answer: "Initial soft tissue healing occurs within 48 to 72 hours. Most patients resume desk work the following morning. Complete bone regeneration inside the extraction socket takes 6 to 10 weeks. We provide detailed aftercare instructions and cold compresses to ensure seamless, swelling-free healing."
  },
  {
    question: "What is bone grafting or socket preservation?",
    answer: "When a tooth is removed, the surrounding jawbone naturally resorbs by 30-50% within the first 6 months. By placing a biocompatible bone graft into the socket immediately after extraction (socket preservation), we maintain natural jawline contour and ensure solid bone support for future dental implants."
  },
  {
    question: "What is the cost of tooth extraction in Hennur, Bangalore?",
    answer: "At House of Dental Hennur, simple tooth extractions range from Rs. 1,500 to Rs. 3,500 depending on tooth location and root anatomy. Complex or surgical extractions involving root sectioning range from Rs. 3,500 to Rs. 7,000. Transparent pricing is provided upfront following your low-radiation digital RVG X-ray."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Tooth Extraction", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Painless Tooth Extraction & Socket Preservation",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "OralSurgery",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
