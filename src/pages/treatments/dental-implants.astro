---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Dental Implants in Bangalore | Permanent Tooth Replacement | House of Dental";
const pageDescription = "Restore missing teeth with permanent dental implants in Bangalore at House of Dental. Titanium & zirconia implants, single to full-arch restorations & transparent pricing.";
const canonicalUrl = "https://aurevadental.com/treatments/dental-implants";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Dental%20Implants%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "How long do dental implants last?",
    answer: "With routine oral hygiene and biannual check-ups, dental implants are designed to be a permanent, lifetime solution. The biocompatible titanium or zirconia post fuses directly with your jawbone through osseointegration, boasting clinical success rates over 98% across decades."
  },
  {
    question: "Is dental implant surgery painful?",
    answer: "No. The procedure is performed under precise local anesthesia or gentle sedation, ensuring complete numbness throughout the procedure. Most patients report that implant placement involves less post-operative discomfort than a standard tooth extraction, typically manageable with mild pain relief for 1–2 days."
  },
  {
    question: "What is the difference between titanium and zirconia implants?",
    answer: "Titanium implants are the gold standard with over 50 years of clinical evidence, offering immense tensile strength and rapid osseointegration. Zirconia implants are 100% ceramic and metal-free, making them ideal for patients with metal sensitivities or thin gum biotypes where complete ceramic aesthetics are prioritized."
  },
  {
    question: "What is the cost of dental implants at House of Dental in Bangalore?",
    answer: "At House of Dental, single dental implants start from Rs. 25,000 to Rs. 60,000 depending on the implant brand system (Nobel Biocare, Straumann, Osstem) and surgical requirements. An implant with a custom CAD/CAM zirconia crown ranges between Rs. 45,000 and Rs. 80,000. Full-mouth rehabilitations start from Rs. 2,50,000. We accept all major Credit Cards, Debit Cards, UPI, and Net Banking; post-payment monthly EMI conversion is available via your issuing bank."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dental Implants", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Dental Implants & Tooth Replacement",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "OralSurgery",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dental Implants</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Permanent Implantology &bull; Hennur Bande, Bengaluru
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Permanent, Pain-Free <span class="italic text-japandi-moss">Dental Implants.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Restore the natural strength, beauty, and function of your teeth. With 3D CBCT surgical guides, premium titanium and zirconia systems, and lifelike CAD/CAM crowns, you can eat, smile, and speak with total confidence.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Book Implant Consultation</span>
          </a>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

        <div class="pt-4 flex items-center gap-6 text-xs text-japandi-earth">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>98%+ Success Rate</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Lifetime Warranty Options</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Keyhole Guided Placement</span>
          </div>
        </div>
      </div>

      <!-- Quick Highlights Card -->
      <div class="lg:col-span-5 animate-slow-fade" style="animation-delay: 0.2s;">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 relative">
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">Precision Implant Features</h3>
          
          <ul class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Natural Chewing Power:</strong> Restores 99% of original bite force so you can eat apples, nuts, and meats naturally.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Prevents Jaw Bone Loss:</strong> Stimulates alveolar bone to halt facial sagging and premature aging.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Protects Adjacent Healthy Teeth:</strong> No grinding or filing of neighboring natural teeth required (unlike traditional bridges).</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Bespoke Zirconia Aesthetics:</strong> Translucent ceramic shading customized to blend indistinguishably with your smile.</div>
            </li>
          </ul>

          <div class="mt-8 pt-6 border-t border-japandi-clay/40 flex items-center justify-between text-xs">
            <span class="text-japandi-earth">Consultation & RVG X-ray</span>
            <span class="font-serif text-base font-semibold text-japandi-charcoal">Rs. 600</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Single Tooth vs Full Mouth Implants -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Tailored Solutions</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Single Tooth vs. Full Mouth Rehabilitation
        </h2>
        <p class="text-sm text-japandi-earth font-light mt-3 leading-relaxed">
          Whether you are replacing a single fractured molar or seeking a permanent alternative to loose dentures, we customize the surgical strategy to your bone anatomy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-3xl p-8 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Individual Tooth</span>
            <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Single Dental Implant</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              Replaces an individual missing tooth root and crown without compromising adjacent healthy teeth. Ideal for front teeth or single molar loss.
            </p>
          </div>
          <div class="pt-4 border-t border-japandi-clay/30 text-xs text-japandi-charcoal font-medium">
            Starting from Rs. 25,000 / implant
          </div>
        </div>

        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-3xl p-8 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Multiple Teeth</span>
            <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Implant-Supported Bridge</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              Two implants strategically anchor a 3 or 4-unit ceramic bridge, spanning wide gaps securely without requiring an individual implant for each missing tooth.
            </p>
          </div>
          <div class="pt-4 border-t border-japandi-clay/30 text-xs text-japandi-charcoal font-medium">
            Customized multi-unit plan
          </div>
        </div>

        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-3xl p-8 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Full Arch Replacement</span>
            <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">All-on-4 & All-on-6</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              Rehabilitate an entire upper or lower dental arch on 4 to 6 strategically tilted implants. Permanent, non-removable teeth with same-day provisional options.
            </p>
          </div>
          <div class="pt-4 border-t border-japandi-clay/30 text-xs text-japandi-charcoal font-medium">
            From Rs. 2,50,000 / arch
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Surgical Guide Precision & Bone Health -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Advanced Clinical Engineering</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight mb-6">
          Keyhole Surgical Precision & Bone Health Benefits
        </h2>
        <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          <p>
            Traditional dental implants often relied on invasive gum incising. At House of Dental Hennur, our surgeons utilize <strong class="text-japandi-charcoal font-medium">3D Computer-Guided Surgical Stents</strong> mapped from high-resolution digital scans.
          </p>
          <p>
            This enables micro-surgical "keyhole" insertion with millimeter depth control, bypassing vital nerve pathways and maxillary sinus cavities. Results include minimal swelling, virtually zero bleeding, and accelerated osseointegration.
          </p>
          <p>
            When a tooth is lost, up to 25% of surrounding jawbone density resorbs within the first year alone. Dental implants are the only clinical solution that mimics natural tooth roots to transfer chewing stimulation into the bone, permanently arresting bone decay.
          </p>
        </div>
      </div>

      <!-- Recovery Timeline Card -->
      <div class="bg-japandi-sand/50 border border-japandi-clay/40 rounded-[2.5rem] p-8 sm:p-10">
        <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-6">Recovery Timeline & Protocol</h3>
        
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-full bg-japandi-moss/10 text-japandi-moss font-semibold text-xs flex items-center justify-center shrink-0">1</div>
            <div>
              <h4 class="text-sm font-semibold text-japandi-charcoal">Day 1 – 3: Initial Comfort Phase</h4>
              <p class="text-xs text-japandi-earth font-light mt-1">Mild tenderness managed with prescribed pain relievers. Return to work and daily activities within 24 hours.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-full bg-japandi-moss/10 text-japandi-moss font-semibold text-xs flex items-center justify-center shrink-0">2</div>
            <div>
              <h4 class="text-sm font-semibold text-japandi-charcoal">Weeks 8 – 12: Biological Osseointegration</h4>
              <p class="text-xs text-japandi-earth font-light mt-1">Bone cells seamlessly fuse with the microscopic implant surface, forming an unbreakable biocompatible anchor.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-full bg-japandi-moss/10 text-japandi-moss font-semibold text-xs flex items-center justify-center shrink-0">3</div>
            <div>
              <h4 class="text-sm font-semibold text-japandi-charcoal">Final Stage: Crown Placement</h4>
              <p class="text-xs text-japandi-earth font-light mt-1">Digital scanning for your custom high-translucency Zirconia crown, precision-screwed for lifelong stability.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Cost Breakdown -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Transparent Fees</p>
        <h2 class="text-3xl font-serif text-japandi-charcoal font-medium">Dental Implant Cost Breakdown</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <h4 class="font-serif text-base font-medium text-japandi-charcoal">Standard Implant Procedure</h4>
          <div class="space-y-3 text-xs text-japandi-earth font-light">
            <div class="flex justify-between border-b border-japandi-clay/20 pb-2">
              <span>New Patient Consultation & RVG</span>
              <span class="font-semibold text-japandi-charcoal">Rs. 600</span>
            </div>
            <div class="flex justify-between border-b border-japandi-clay/20 pb-2">
              <span>Dental Implant Post (Per Unit)</span>
              <span class="font-semibold text-japandi-charcoal">Rs. 25,000 – Rs. 60,000</span>
            </div>
            <div class="flex justify-between border-b border-japandi-clay/20 pb-2">
              <span>Implant with Custom Ceramic Crown</span>
              <span class="font-semibold text-japandi-charcoal">Rs. 45,000 – Rs. 80,000</span>
            </div>
            <div class="flex justify-between">
              <span>Bone Grafting / Sinus Lift (If Needed)</span>
              <span class="font-semibold text-japandi-charcoal">Rs. 10,000 onwards</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-japandi-sand/60 border border-japandi-clay/40 flex flex-col justify-between">
          <div>
            <h4 class="font-serif text-base font-medium text-japandi-charcoal mb-2">Transparent Pricing & Payment Terms</h4>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              All treatment estimates are documented in writing prior to surgery. We accept all major Credit Cards, Debit Cards, UPI, and Net Banking. Patients wishing to split payments into monthly installments can seamlessly convert credit card transactions into flexible monthly EMIs directly via their bank's post-payment portal or net banking app.
            </p>
          </div>
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-colors"
          >
            Get Custom Treatment Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Item FAQ Accordion -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-2">Patient Guidance</p>
        <h2 class="text-3xl font-serif text-japandi-charcoal font-medium">Dental Implants FAQ</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
              aria-expanded="false"
            >
              <span class="text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                {faq.question}
              </span>
              <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Treatments & Local Care in Hennur -->
  <section class="py-12 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related Treatments &amp; Local Dental Care in Hennur</h3>
        <p class="text-xs text-japandi-earth font-light">Explore complementary restorative and tooth replacement services at our Hennur studio:</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/root-canal-treatment" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Root Canal Treatment &rarr;</span>
