---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Cosmetic Dentistry in Bangalore | Veneers & Smile Design | House of Dental";
const pageDescription = "Transform your smile with porcelain veneers, composite bonding & smile makeovers at House of Dental in Bangalore. Schedule your smile consultation.";
const canonicalUrl = "https://aurevadental.com/treatments/cosmetic-dentistry";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Cosmetic%20Dentistry%20and%20Smile%20Design%20at%20House%20of%20Dental.";

const faqs = [
  {
    question: "How long do porcelain veneers last?",
    answer: "High-grade porcelain and lithium disilicate (E.max) veneers typically last 15 to 20 years or longer with proper oral hygiene and regular dental checkups. Because porcelain is non-porous and ultra-glazed, it resists stains from coffee, tea, and red wine far better than natural enamel."
  },
  {
    question: "Will professional teeth whitening damage my dental enamel?",
    answer: "No. Our clinic uses professional, pH-neutral hydrogen peroxide and carbamide peroxide formulations combined with low-heat LED/laser acceleration. This process releases oxygen molecules to safely dissolve deep microscopic discolored stains inside the enamel without eroding or weakening the tooth structure."
  },
  {
    question: "What is the difference between composite bonding and porcelain veneers?",
    answer: "Composite bonding involves direct, hand-sculpted resin applied in a single visit without removing enamel, ideal for minor chips, gaps, or small shape corrections (starting from Rs. 2,500/tooth). Porcelain veneers are ultra-thin, custom-fabricated ceramic shells bonded to the front tooth surface, offering superior natural translucency, longevity, and stain resistance (Rs. 8,000–Rs. 25,000/tooth)."
  },
  {
    question: "How much does a complete smile makeover cost in Bangalore?",
    answer: "Smile makeover investments vary based on the combination of treatments required. Digital Smile Design planning is Rs. 3,000 to Rs. 7,000. In-office laser teeth whitening ranges from Rs. 6,000 to Rs. 15,000. Full smile aesthetic rehabilitations start from Rs. 80,000 onwards. We accept all major Credit Cards, Debit Cards, UPI, and Net Banking; patients can convert transactions into monthly EMIs directly through their bank's post-payment portal or app."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Cosmetic Dentistry", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Cosmetic Dentistry & Smile Design",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "CosmeticDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Cosmetic Dentistry</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Aesthetic Architecture &bull; Hennur, Bengaluru
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Crafting Harmonious Smiles With <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Cosmetic Dentistry & Veneers.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Where biological dental precision meets facial aesthetic art. Elevate your smile with ultra-thin porcelain veneers, artistic composite bonding, and in-office teeth whitening planned with Digital Smile Design (DSD).
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Book Smile Design Consultation</span>
          </a>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

        <div class="pt-4 flex items-center gap-6 text-xs text-japandi-earth">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Digital 2D/3D Mockups</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Bridal & Groom Packages</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-japandi-moss"></span>
            <span>Ultra-Thin E.max Porcelain</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card -->
      <div class="lg:col-span-5 animate-slow-fade" style="animation-delay: 0.2s;">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 relative">
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">The Aesthetic Philosophy</h3>
          
          <ul class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Facial Symmetry Planning:</strong> We analyze your lip dynamics, pupillary line, and skin tone to craft teeth shapes that look authentically yours.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Minimally Invasive:</strong> Conservative tooth preparation preserving the maximum amount of natural biological enamel.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Try Before You Buy:</strong> Test-drive your temporary 3D resin smile mockup directly in your mouth before permanent porcelain bonding.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Permanent Color Stability:</strong> E.max glass ceramics resist staining from turmeric, coffee, tea, and red wine permanently.</div>
            </li>
          </ul>

          <div class="mt-8 pt-6 border-t border-japandi-clay/40 flex items-center justify-between text-xs">
            <span class="text-japandi-earth">Smile Consultation</span>
            <span class="font-serif text-base font-semibold text-japandi-charcoal">Rs. 500</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Modalities: Veneers, Bonding, Whitening -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-14">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Tailored Treatments</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Our Core Cosmetic Dental Services
        </h2>
        <p class="text-sm text-japandi-earth font-light mt-3 leading-relaxed">
          From subtle refinements to red-carpet transformations, our clinicians combine the latest ceramic science with gentle clinical hands.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Porcelain Veneers -->
        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-3xl p-8 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Artisan Ceramics</span>
            <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Porcelain Veneers</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              Wafer-thin shells of E.max lithium disilicate ceramic custom-bonded to the front of teeth. Masks severe fluorosis, intrinsic discoloration, chips, and irregular tooth proportions.
            </p>
          </div>
          <div class="pt-4 border-t border-japandi-clay/30 text-xs text-japandi-charcoal font-medium">
            Rs. 8,000 – Rs. 25,000 / tooth
          </div>
        </div>

        <!-- Composite Bonding -->
        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-3xl p-8 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Single-Visit Artistry</span>
            <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Composite Edge Bonding</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              Micro-hybrid aesthetic resin sculpted directly onto your teeth to close gaps (diastemas), repair jagged edges, or smooth minor overlaps in just one 60-minute visit.
            </p>
          </div>
          <div class="pt-4 border-t border-japandi-clay/30 text-xs text-japandi-charcoal font-medium">
            Rs. 2,500 – Rs. 5,000 / tooth
          </div>
        </div>

        <!-- Professional Laser Whitening -->
        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-3xl p-8 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <span class="text-[10px] font-semibold text-japandi-moss uppercase tracking-wider block mb-2">Instant Radiance</span>
            <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">Professional Laser Whitening</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed mb-4">
              Medical in-office light-activated whitening system brightening teeth by up to 6–8 shades in under 45 minutes with integrated desensitizing agents for zero sensitivity.
            </p>
          </div>
          <div class="pt-4 border-t border-japandi-clay/30 text-xs text-japandi-charcoal font-medium">
            Rs. 6,000 – Rs. 15,000 / session
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Digital Smile Design (DSD) Workflow -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">Predictable Aesthetics</p>
        <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight mb-6">
          Digital Smile Design (DSD): Preview Before You Commit
        </h2>
        <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          <p>
            You wouldn't build a luxury home without an architectural blueprint. Why design a new smile without previewing the outcome?
          </p>
          <p>
            With <strong class="text-japandi-charcoal font-medium">Digital Smile Design</strong>, our aesthetic architects record high-definition photographs and intraoral 3D scans of your mouth, analyzing facial midline, lip curves, and tooth proportions using mathematical golden ratios.
          </p>
          <p>
            We 3D-print a temporary "mockup" that snaps directly over your teeth. You can look in the mirror, smile, take selfies, and provide feedback before any permanent porcelain is crafted.
          </p>
        </div>
      </div>

      <!-- Bridal & Groom Smile Packages Card -->
      <div class="bg-japandi-sand/50 border border-japandi-clay/40 rounded-[2.5rem] p-8 sm:p-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss text-[10px] font-semibold uppercase tracking-wider mb-4">
          Curated For Special Occasions
        </div>
        <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">Bridal & Groom Smile Radiance Packages</h3>
        <p class="text-xs text-japandi-earth font-light leading-relaxed mb-6">
          Ensure your wedding album features a luminous, picture-perfect smile. Scheduled conveniently 1 to 4 weeks prior to your big day.
        </p>

        <div class="space-y-4 text-xs text-japandi-charcoal">
          <div class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/30 flex justify-between items-center">
            <div>
              <span class="font-semibold block text-sm">The Express Glow</span>
              <span class="text-japandi-earth font-light">Deep Ultrasonic Scaling + Air-Polish + In-office Whitening</span>
            </div>
            <span class="font-serif text-sm font-semibold text-japandi-moss">Rs. 12,000</span>
          </div>

          <div class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/30 flex justify-between items-center">
            <div>
              <span class="font-semibold block text-sm">The Signature Bride / Groom</span>
              <span class="text-japandi-earth font-light">Whitening + 2 Composite Edge Artistry Touchups + Enamel Glow</span>
            </div>
            <span class="font-serif text-sm font-semibold text-japandi-moss">Rs. 35,000</span>
          </div>

          <div class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/30 flex justify-between items-center">
            <div>
              <span class="font-semibold block text-sm">Couple's Wedding Radiance Pass</span>
              <span class="text-japandi-earth font-light">Dual complete smile prep for bride & groom + Priority booking</span>
            </div>
            <span class="font-serif text-sm font-semibold text-japandi-moss">Rs. 1,80,000</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Item FAQ Accordion -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-2">Patient Guidance</p>
        <h2 class="text-3xl font-serif text-japandi-charcoal font-medium">Cosmetic Dentistry FAQ</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="faq-item bg-japandi-sand/45 border border-japandi-clay/45 rounded-2xl overflow-hidden transition-all duration-300 hover:border-japandi-moss/50">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-none group"
              aria-expanded="false"
            >
              <span class="text-base font-serif text-japandi-charcoal font-medium group-hover:text-japandi-moss transition-colors">
                {faq.question}
              </span>
              <div class="w-7 h-7 rounded-full bg-japandi-cream border border-japandi-clay/60 flex items-center justify-center shrink-0 text-japandi-moss group-hover:bg-japandi-moss group-hover:text-japandi-cream transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 faq-icon transition-transform duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out px-6 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              <div class="pb-5 pt-1 border-t border-japandi-clay/20">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Treatments & Local Care in Hennur -->
  <section class="py-12 px-6 lg:px-24 bg-japandi-sand/30 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related Treatments &amp; Local Dental Care in Hennur</h3>
        <p class="text-xs text-japandi-earth font-light">Explore complementary aesthetic and smile makeover treatments at our Hennur studio:</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/teeth-whitening" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Teeth Whitening &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Laser brightening to remove stubborn enamel stains.</span>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Clear Aligners &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Straighten teeth without brackets prior to veneer placement.</span>
        </a>
        <a href="/dental-clinic-in-hennur" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Hennur Dental Studio &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Explore our Japandi clinic facility &amp; aesthetic diagnostic equipment.</span>
        </a>
        <a href="/contact" class="p-4 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Contact Clinic &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Get driving directions, clinic map &amp; parking info on Horamavu Agara Rd.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Catchment Footer Note & Final Callout -->
  <section class="py-14 px-6 lg:px-24 bg-japandi-sand/40 border-t border-japandi-clay/30 text-center">
    <div class="max-w-4xl mx-auto space-y-4">
      <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Design Your Dream Smile with Our Artisans</h3>
      <p class="text-xs text-japandi-earth font-light max-w-xl mx-auto leading-relaxed">
        Conveniently located for patients across Hennur Bande, Horamavu Agara Road, Kalyan Nagar, Kothanur, and North Bengaluru.
      </p>
      <div class="pt-3 flex items-center justify-center gap-3">
        <a 
          href={phoneCallUrl}
          class="px-6 py-3 rounded-full border border-japandi-moss text-japandi-moss text-xs font-semibold uppercase tracking-wider hover:bg-japandi-moss/10 transition-colors"
        >
          Call: 09113563040
        </a>
        <a 
          href={whatsappUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-colors shadow-sm"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupPageAccordions() {
    const items = document.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const toggle = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content') as HTMLElement;
      const icon = item.querySelector('.faq-icon');
      if (!toggle || !content) return;

      const newBtn = toggle.cloneNode(true) as HTMLElement;
      toggle.parentNode?.replaceChild(newBtn, toggle);

      newBtn.addEventListener('click', () => {
        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
        items.forEach((other) => {
          if (other !== item) {
            const ob = other.querySelector('.faq-toggle');
            const oc = other.querySelector('.faq-content') as HTMLElement;
            const oi = other.querySelector('.faq-icon');
            if (ob && oc) {
              ob.setAttribute('aria-expanded', 'false');
              oc.style.maxHeight = '0px';
              oi?.classList.remove('rotate-45');
            }
          }
        });

        if (isExpanded) {
          newBtn.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0px';
          icon?.classList.remove('rotate-45');
        } else {
          newBtn.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
          icon?.classList.add('rotate-45');
        }
      });
    });
  }

  setupPageAccordions();
  document.addEventListener('astro:after-swap', setupPageAccordions);
</script>
