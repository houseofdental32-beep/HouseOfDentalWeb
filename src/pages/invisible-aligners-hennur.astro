---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Invisible Aligners in Hennur | House of Dental";
const pageDescription = "Discreet invisible aligners in Hennur, Bangalore at House of Dental. 3D digital smile scan, customized clear aligner trays & 0% bank EMI options available.";
const canonicalUrl = "https://aurevadental.com/invisible-aligners-hennur";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20would%20like%20to%20book%20a%20consultation%20for%20Invisible%20Aligners%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/clear-aligners" },
  { name: "Invisible Aligners Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "How do invisible aligners straighten teeth without metal wires?",
    answer: "Invisible aligners are custom-manufactured series of transparent, medical-grade thermoplastic trays (polyurethane). Using 3D computer-aided software, your treatment is mapped in advance. Each sequential aligner applies gentle, controlled biomechanical force to specific teeth, gradually shifting them by approximately 0.25mm per tray until your ideal alignment is achieved."
  },
  {
    question: "How many hours per day must I wear my clear aligners?",
    answer: "For optimal biological tooth movement, clear aligners must be worn for 20 to 22 hours per day. You only remove them while eating, drinking hot or sugary beverages, and brushing or flossing your teeth. Inconsistent wear delays tooth tracking and prolongs overall treatment duration."
  },
  {
    question: "What is the cost of invisible aligners in Hennur, Bangalore?",
    answer: "At House of Dental, invisible aligner packages typically range between Rs. 80,000 and Rs. 2,50,000 depending on the complexity of malocclusion (mild crowding, moderate spacing, or complex bite correction), number of total trays required, and whether you choose in-house customized digital aligners or international systems like Invisalign. Transparent pricing with zero-interest monthly EMI plans is provided upfront."
  },
  {
    question: "Can invisible aligners fix severe crowding or overbites?",
    answer: "Yes. Advanced clear aligner protocols utilize tooth-colored composite attachments (small aesthetic grips bonded to enamel) and intermaxillary elastics to successfully correct deep overbites, open bites, crossbites, and severe crowding without unsightly metal brackets."
  },
  {
    question: "Are clear aligners painful to wear?",
    answer: "Clear aligners are vastly more comfortable than traditional metal or ceramic braces. There are no sharp metal brackets to cut your cheeks or lips and no wires requiring tightening. When transitioning to a new aligner tray every 7 to 10 days, you will feel mild, temporary tightness for the first 24 to 48 hours, which simply confirms active tooth movement."
  },
  {
    question: "How do I get started with invisible aligners at House of Dental in Hennur?",
    answer: "Getting started begins with an initial digital smile assessment at our Horamavu Agara Road clinic. We perform a high-resolution 3D digital intraoral scan of your teeth, generate an instant 3D simulation showing your future straight smile, discuss wear expectations, and initiate custom tray fabrication."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Invisible Aligners in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Orthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
