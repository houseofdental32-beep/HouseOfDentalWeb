---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Best Dentist in Hennur Bangalore | House of Dental";
const pageDescription = "Looking for the best dentist in Hennur, Bangalore? House of Dental offers painless root canals, dental implants, clear aligners & gentle family dental care.";
const canonicalUrl = "https://aurevadental.com/dentist-in-hennur";
const phoneCallUrl = "tel:09113563040";
const whatsappUrl = "https://wa.me/919113563040?text=Hello%20House%20of%20Dental%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20a%20dentist%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Dentist in Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Who is the best dentist in Hennur for painless treatment?",
    answer: "At House of Dental in Hennur, our clinical practice is headed by Dr. Shweta Singh (BDS, Lead Aesthetic Architect & Clinical Director) and Dr. Agniss Mishra (BDS, Dental Surgeon), both alumni of The Oxford Dental College, Bangalore and registered with the Karnataka State Dental Council (KSDC). We utilize computerized anesthesia delivery, digital apex locators, and rotary micro-instruments to ensure dental treatments remain completely painless and anxiety-free."
  },
  {
    question: "Where is House of Dental located in Hennur?",
    answer: "House of Dental is conveniently situated on the 2nd Floor, No. 11/4, SLV Nilaya, Horamavu Agara Road, directly near Nayara Petrol Bunk, Hennur Bande, Bengaluru 562149. We serve residents across Hennur Road, Horamavu, Kalyan Nagar, HRBR Layout, Babusapalya, Geddalahalli, Kothanur, and Byrathi with dedicated patient parking facilities on premise."
  },
  {
    question: "What are the clinic timings, and are you open on Sundays?",
    answer: "Yes, House of Dental is open on Sundays from 9:30 AM to 9:00 PM. Our weekday hours are Monday from 4:00 PM to 9:00 PM, and Tuesday through Saturday from 9:30 AM to 9:00 PM. We accommodate evening consultations for IT professionals and same-day dental emergency walk-ins."
  },
  {
    question: "How much does a dental consultation cost at your Hennur clinic?",
    answer: "Our comprehensive initial dental consultation is Rs. 600, which includes a full intraoral clinical assessment, high-resolution low-radiation digital RVG X-rays when indicated, and a customized, transparent digital treatment roadmap with zero hidden costs."
  },
  {
    question: "How do you maintain sterilization and patient safety?",
    answer: "We follow strict four-tier hospital-grade sterilization protocols compliant with CDC and OSHA guidelines. All metallic instruments undergo ultrasonic pre-cleaning followed by Class-B vacuum autoclave sterilization in sealed, color-changing pouches opened exclusively in front of the patient. All surfaces, suction tips, and barriers are 100% disposable and disinfected between every visit."
  },
  {
    question: "Do you offer emergency dental treatments for acute toothache in Hennur?",
    answer: "Yes, we prioritize same-day emergency appointments for acute toothaches, chipped or cracked teeth, fractured restorations, facial swelling, and accidental dental trauma. Please call our clinic reception desk at 09113563040 or reach out via WhatsApp for immediate triage guidance."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dentist in Hennur</span>
    </div>
  </nav>

  <!-- Hero Header Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Family &amp; Cosmetic Dentistry &bull; Hennur, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Experienced, Compassionate <br class="hidden sm:inline"/>
          <span class="italic text-japandi-moss">Dentist in Hennur.</span>
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Welcome to House of Dental, a modern dental sanctuary designed around your peace of mind. Founded by Dr. Shweta Singh, BDS (Clinical Director) alongside dental surgeon Dr. Agniss Mishra, BDS, we provide gentle, precision-driven oral healthcare for families across Hennur, Horamavu, Kalyan Nagar, and North Bangalore.
        </p>

        <!-- Direct Action CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            data-treatment="General Consultation - Hennur"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Dentist Visit</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-4 border border-japandi-clay hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 bg-japandi-sand/40 hover:bg-japandi-sand cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call 09113563040</span>
          </a>
        </div>

