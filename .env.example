# Vercel KV Database (Automatically injected by Vercel when you link a KV database)
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=your_kv_rest_token

# Vercel Cron Secret (Set in Vercel Environment Variables)
CRON_SECRET=your_random_secure_cron_secret

# SerpApi API Key (Free tier from https://serpapi.com/ - 100 free searches/month, No Credit Card required)
SERPAPI_API_KEY=your_serpapi_api_key_here
